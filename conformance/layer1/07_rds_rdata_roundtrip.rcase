=== case: serialize_null_in_both_versions ===
#@ tags: serialize,rds
for (version in 2:3) {
    bytes <- serialize(NULL, NULL, version = version)
    dput(typeof(bytes))
    dput(identical(unserialize(bytes), NULL))
}

=== case: serialize_logical_and_integer_vectors ===
#@ tags: serialize,rds
values <- list(c(TRUE, NA, FALSE), c(-2147483647L, 0L, 2147483647L, NA_integer_))
for (version in 2:3) {
    for (x in values) {
        dput(identical(unserialize(serialize(x, NULL, version = version)), x))
    }
}

=== case: serialize_double_special_values_and_negative_zero ===
#@ tags: serialize,rds
x <- c(1.25, NA_real_, NaN, Inf, -Inf, -0.0, 0.0)
for (version in 2:3) {
    value <- unserialize(serialize(x, NULL, version = version))
    dput(identical(value, x))
    dput(1 / value[6:7])
}

=== case: serialize_complex_vector ===
#@ tags: serialize,rds
x <- complex(real = c(1, NA_real_, 0), imaginary = c(-2, 4, Inf))
for (version in 2:3) {
    dput(identical(unserialize(serialize(x, NULL, version = version)), x))
}

=== case: serialize_utf8_and_missing_strings ===
#@ tags: serialize,rds
x <- c("caf\u00e9", "\u754c", "", NA_character_)
for (version in 2:3) {
    value <- unserialize(serialize(x, NULL, version = version))
    dput(identical(value, x))
    dput(Encoding(value))
}

