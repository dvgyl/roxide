=== case: serialize_nested_named_lists ===
#@ tags: serialize,rds
x <- list(site = list(name = "ridge", counts = c(oak = 5L, ash = 2L)),
          empty = list(), marker = NULL)
for (version in 2:3) {
    dput(identical(unserialize(serialize(x, NULL, version = version)), x))
}

=== case: serialize_s3_object_and_attributes ===
#@ tags: serialize,rds
x <- structure(c(first = 12.5, second = 14), class = c("sample_mass", "numeric"),
               unit = "g", limits = c(0, 100))
for (version in 2:3) {
    value <- unserialize(serialize(x, NULL, version = version))
    dput(identical(value, x, attrib.as.set = FALSE))
}

