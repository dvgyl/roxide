=== case: linalg_named_dimension_axes ===
#@ tags: base,linalg
#@ compare: exact
A <- matrix(1:4,2,dimnames=list(rows=c("a","b"),cols=c("c","d")))
B <- matrix(1:4,2,dimnames=list(rows2=c("e","f"),cols2=c("g","h")))
dput(dimnames(A %*% B))
dput(dimnames(crossprod(A,B)))
dput(dimnames(tcrossprod(A,B)))
dput(dimnames(qr.R(qr(A))))
dput(dimnames(qr.qty(qr(A),B)))
dput(dimnames(chol(crossprod(A))))
dput(attributes(outer(A,1:2)))
dput(attributes(kronecker(c(a=1,b=2),c(x=3,y=4),make.dimnames=TRUE)))

=== case: linalg_matrix_group_dispatch ===
#@ tags: base,linalg
#@ compare: exact
matrixOps.demo <- function(x, y = NULL, ...) .Generic
x <- structure(2,class="demo")
dput(x %*% 1)
dput(crossprod(x,1))
dput(tcrossprod(x))
dput(typeof(crossprod))
dput(typeof(tcrossprod))
tryCatch(crossprod(),error=function(e) cat(conditionMessage(e),"\n"))
tryCatch(tcrossprod(1,),error=function(e) cat(conditionMessage(e),"\n"))
