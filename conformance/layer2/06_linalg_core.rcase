=== case: linalg_matrix_product_shapes_and_names ===
#@ tags: base,linalg
#@ compare: exact
A <- matrix(1:6, 2, dimnames=list(c("a","b"),c("x","y","z")))
dput(c(left=2,right=3) %*% A)
dput(A %*% c(x=2,y=3,z=4))
dput(crossprod(A,c(2,3)))
dput(tcrossprod(1:3,A))
dput(crossprod(A))
dput(matrix(numeric(),2,0) %*% matrix(numeric(),0,3))
tryCatch(tcrossprod(A,1:3),error=function(e) cat(conditionMessage(e),"\n"))

