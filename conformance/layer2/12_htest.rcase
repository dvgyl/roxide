=== case: htest_t_intervals ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
for (v in list(t.test(x, mu=3), t.test(x,y), t.test(x,y,var.equal=TRUE,alternative="greater"),
               t.test(x,y,paired=TRUE,alternative="less"))) {
    cat(v$statistic, v$parameter, v$p.value, v$estimate, v$stderr, "\n")
    cat(v$conf.int, attr(v$conf.int,"conf.level"), v$null.value, "\n")
}

=== case: htest_t_metadata ===
#@ tags: layer2,htest
#@ compare: exact
x <- 1:8
y <- 2:9
v <- t.test(x,y,var.equal=TRUE,alternative="l")
cat(class(v), names(v), "\n")
dput(v$method)
dput(v$alternative)
dput(v$data.name)
dput(names(v$estimate))
dput(v$null.value)

=== case: htest_signed_rank_with_zero_and_ties ===
#@ tags: layer2,htest
#@ compare: rel=1e-8
x <- c(0,1,1,2)
for (exact in c(TRUE,FALSE)) {
    v <- wilcox.test(x,exact=exact)
    cat(v$statistic,v$p.value,"\n")
    cat(v$method,v$data.name,"\n")
}
ci <- wilcox.test(x,exact=TRUE,conf.int=TRUE)$conf.int
cat(ci,attr(ci,"conf.level"),"\n")

=== case: htest_rank_sum_confidence_interval ===
#@ tags: layer2,htest
#@ compare: rel=2e-5
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
for (exact in c(TRUE,FALSE)) {
    v <- wilcox.test(x,y,exact=exact,conf.int=TRUE)
    cat(v$statistic, v$p.value, v$conf.int, v$estimate, attr(v$conf.int,"conf.level"), "\n")
    cat(names(v), "\n")
}

=== case: htest_chisq_observed_and_expected ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
for (v in list(chisq.test(c(12,8,10)),withCallingHandlers(chisq.test(matrix(c(8,2,1,5),2)), warning=function(w) invokeRestart("muffleWarning")))) {
    cat(v$method, "\n")
    cat(v$statistic, v$parameter, v$p.value, "\n")
    cat(v$observed,v$expected,v$residuals,v$stdres,"\n")
}

=== case: htest_chisq_warning ===
#@ tags: layer2,htest
#@ compare: exact
invisible(tryCatch(chisq.test(c(1,2,3)),warning=function(w) cat(conditionMessage(w),"\n")))
invisible(tryCatch(chisq.test(-1:2),error=function(e) cat(conditionMessage(e),"\n")))

=== case: htest_fixed_margin_simulation ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- matrix(c(8,2,1,5),2)
y <- matrix(c(3,1,2,2,4,1),2)
set.seed(42)
a <- chisq.test(x,simulate.p.value=TRUE,B=2000)
cat(a$p.value,.Random.seed[2],runif(1),"\n")
set.seed(42)
a <- fisher.test(y,simulate.p.value=TRUE,B=2000)
cat(a$p.value,.Random.seed[2],runif(1),"\n")
set.seed(42)
a <- chisq.test(c(12,8,10),p=c(.2,.3,.5),simulate.p.value=TRUE,B=13)
cat(a$p.value,.Random.seed[2],runif(1),"\n")

=== case: htest_fisher_odds_and_alternatives ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- matrix(c(8,2,1,5),2)
for (a in c("two.sided","less","greater")) {
    v <- fisher.test(x,alternative=a)
    cat(v$p.value,v$estimate,v$conf.int,attr(v$conf.int,"conf.level"),"\n")
    cat(names(v),v$method,v$data.name,"\n")
}
cat(fisher.test(matrix(c(3,1,2,2,4,1),2))$p.value,"\n")

=== case: htest_ks_reference_distributions ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
for (a in c("two.sided","less","greater")) {
    for (v in list(ks.test(x,"punif",0,15,alternative=a),ks.test(x,y,alternative=a),
                   ks.test(x,y,alternative=a,exact=FALSE))) {
        cat(v$statistic,v$p.value,v$exact,"\n")
        cat(class(v),names(v$statistic),v$alternative,v$method,v$data.name,"\n")
    }
}

=== case: htest_ks_ties ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
