=== case: htest_result_schema ===
#@ tags: layer2,htest
#@ compare: exact
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
tab <- matrix(c(8,2,1,5),2)
for (v in list(t.test(x,y), wilcox.test(x,y,conf.int=TRUE),
               chisq.test(c(12,8,10)), fisher.test(tab,conf.int=FALSE),
               ks.test(x,y), shapiro.test(x), prop.test(7,10), binom.test(7L,10L),
               cor.test(x,y), var.test(x,y))) {
    cat(class(v),"\n")
    cat(names(v),"\n")
    cat(paste(names(v$statistic),collapse="|"),typeof(v$statistic),
        paste(names(v$parameter),collapse="|"),typeof(v$parameter),"\n")
    cat(paste(names(v$estimate),collapse="|"),paste(names(v$null.value),collapse="|"),
        typeof(attr(v$conf.int,"conf.level")),"\n")
    cat(v$method,v$data.name,"\n")
}
