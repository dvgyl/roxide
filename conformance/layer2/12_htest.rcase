y <- c(1,3,4)
v <- ks.test(x,y,exact=TRUE)
cat(v$p.value,v$exact,"\n")
invisible(tryCatch(ks.test(x,"punif",0,5),warning=function(w) cat(conditionMessage(w),"\n")))
invisible(tryCatch(ks.test(x,y,exact=FALSE),warning=function(w) cat(conditionMessage(w),"\n")))

=== case: htest_shapiro_small_and_large_samples ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
for (x in list(c(1,4,8),c(1,4,6,9,12,NA),sqrt(1:24))) {
    v <- shapiro.test(x)
    cat(v$statistic,v$p.value,v$method,v$data.name,"\n")
}
for (x in list(c(1,NA,3),rep(1,5)))
    invisible(tryCatch(shapiro.test(x),error=function(e) cat(conditionMessage(e),"\n")))

=== case: htest_binomial_and_proportions ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
for (a in c("two.sided","less","greater")) {
    for (v in list(binom.test(7,10,alternative=a),prop.test(7,10,alternative=a),
                   prop.test(c(7,3),c(10,10),alternative=a))) {
        cat(v$statistic,v$parameter,v$p.value,v$estimate,v$conf.int,"\n")
        cat(names(v),v$method,v$data.name,"\n")
    }
}

=== case: htest_correlation_and_variance ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
for (m in c("pearson","kendall","spearman")) {
    v <- cor.test(x,y,method=m)
    cat(round(v$statistic,12),v$parameter,v$p.value,v$estimate,v$conf.int,"\n")
    cat(v$method,v$data.name,"\n")
}
for (a in c("two.sided","less","greater")) {
    v <- var.test(x,y,alternative=a)
    cat(v$statistic,v$parameter,v$p.value,v$estimate,v$conf.int,v$null.value,"\n")
}

=== case: htest_formula_interfaces ===
#@ tags: layer2,htest
#@ compare: rel=2e-6
x <- c(1,4,6,9,12)
y <- c(2,3,7,8,10)
dat <- data.frame(z=c(x,y),g=factor(rep(c("a","b"),each=5L)))
for (v in list(t.test(x~1), t.test(Pair(x,y)~1), t.test(formula=z~g,data=dat), wilcox.test(z~g,dat),
               var.test(z~g,dat),cor.test(~x+y),ks.test(z~g,dat,alternative="greater"))) {
    cat(v$statistic,v$p.value,v$data.name,"\n")
    cat(names(v$estimate),names(v$null.value),v$alternative,"\n")
}

