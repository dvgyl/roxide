=== case: fft_convolution_modes ===
#@ tags: stats,fft
#@ compare: rel=1e-13,abs=1e-13
x <- c(a=1,b=2,c=4)
y <- c(3,5)
for (k in c(TRUE,FALSE)) {
    a <- convolve(x,y,conj=k,type="open")
    b <- convolve(x,y,conj=k,type="filter")
    dput(names(a))
    dput(names(b))
    cat(a,b,convolve(c(x,0),c(y,0,0),conj=k),"\n")
}

=== case: fft_complex_convolution ===
#@ tags: stats,fft
#@ compare: rel=1e-13,abs=1e-13
x <- c(a=1i,b=2)
y <- c(c=1+1i,d=3)
for (mode in c("circular","open","filter")) {
    for (k in c(TRUE,FALSE)) {
        z <- convolve(x,y,conj=k,type=mode)
        dput(names(z))
        cat(Re(z), Im(z), "\n")
    }
}

=== case: complex_svd_reconstruct ===
#@ tags: base,linalg
#@ compare: rel=1e-11,abs=1e-12
x <- matrix(c(2+1i,1i,-2,1-1i,3,4i),3)
for (a in list(x,t(x))) {
    z <- svd(a)
    w <- La.svd(a)
    cat(z$d,w$d,"\n")
    stopifnot(max(Mod(z$u %*% diag(z$d) %*% Conj(t(z$v)) - a)) < 1e-12)
    stopifnot(max(Mod(w$u %*% diag(w$d) %*% w$vt - a)) < 1e-12)
    dput(names(La.svd(a,nu=0,nv=0)))
}

=== case: complex_hermitian_eigen ===
#@ tags: base,linalg
#@ compare: rel=1e-11,abs=1e-12
x <- matrix(c(4,1+2i,0,1-2i,3,2i,0,-2i,-1),3)
z <- eigen(x)
dput(typeof(z$values))
cat(z$values,"\n")
stopifnot(max(Mod(x %*% z$vectors - z$vectors %*% diag(z$values))) < 1e-12)
dput(class(z))

=== case: complex_general_eigen ===
#@ tags: base,linalg
#@ compare: rel=1e-11,abs=1e-12
x <- matrix(c(2+4i,1i,3i,1-1i,3,6,3i,1,4),3)
z <- eigen(x)
cat(Re(z$values),Im(z$values),"\n")
stopifnot(max(Mod(x %*% z$vectors - z$vectors %*% diag(z$values))) < 1e-12)
stopifnot(is.null(eigen(x,only.values=TRUE)$vectors))

=== case: ts_creation_and_calendar ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- ts(1:8, start=c(2000,2), frequency=4)
dput(is.ts(x))
dput(is.mts(x))
dput(tsp(x))
dput(start(x))
dput(end(x))
dput(frequency(x))
dput(deltat(x))
dput(time(x))
dput(cycle(x))

=== case: ts_matrix_and_tsp_assignment ===
#@ tags: stats,ts
x <- ts(matrix(1:12,6), start=2, frequency=2, names=c("a","b"))
dput(is.mts(x))
dput(class(x))
dput(colnames(x))
dput(tsp(as.ts(x)))
saved <- x
tsp(x) <- c(3,5.5,2)
dput(tsp(x))
dput(tsp(saved))
tsp(x) <- NULL
dput(is.ts(x))

=== case: ts_window_lag_diff ===
#@ tags: stats,ts
x <- ts(1:8,start=c(2000,2),frequency=4)
dput(window(x,start=c(2000,3),end=c(2001,2)))
dput(window(x,start=1999,end=2000.5,extend=TRUE))
dput(window(x,frequency=2))
dput(tsp(lag(x,2)))
dput(diff(x,lag=2,differences=2))

=== case: ts_filters ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- ts(1:8,start=c(2000,2),frequency=4)
dput(filter(x,c(1,2,3,4)))
dput(filter(x,c(1,2),sides=1,circular=TRUE))
z <- filter(x,c(.5,.2),method="recursive",init=c(2,3))
cat(as.double(z), tsp(z), "\n")
m <- ts(matrix(1:12,6), frequency=2)
dput(filter(m,1:2))
dput(filter(m,1:2,method="recursive",init=matrix(1:4,2)))

=== case: ts_autocorrelations ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- ts(1:8,start=c(2000,2),frequency=4)
for (z in list(acf(x,2,plot=FALSE),pacf(x,2,plot=FALSE))) {
    dput(class(z))
    dput(names(z))
    cat(z$acf,z$lag,z$series,z$type,z$n.used,"\n")
}

=== case: ts_cross_correlations ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- c(1,0,0,0)
y <- c(0,1,0,0)
z <- ccf(x,y,lag.max=2,plot=FALSE)
cat(z$acf,z$lag,"\n")
dput(z$snames)
m <- ts(cbind(c(3,2,4,8,5,0), c(4,6,5,1,2,3)),frequency=3)
for (z in list(acf(m,2,plot=FALSE),pacf(m,2,plot=FALSE))) {
    cat(z$acf,z$lag,"\n")
    dput(z$snames)
}

=== case: ts_decompose_and_box_tests ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- ts(1:12 + rep(c(1,-1,-2,2),3), frequency=4)
z <- decompose(x)
dput(names(z))
cat(z$figure,as.double(z$seasonal),as.double(z$trend),as.double(z$random),"\n")
for (t in c("Box-Pierce","Ljung-Box")) {
    z <- Box.test(x,lag=3,type=t,fitdf=1)
    dput(class(z))
    cat(z$statistic,z$parameter,z$p.value,z$method,z$data.name,"\n")
}

