b <- ts(2:5,start=3)
z <- convolve(a,b)
cat(as.double(z),tsp(z),"\n")
dput(class(z))
m <- matrix(1:4,2L,dimnames=list(c("a","b"),c("x","y")))
z <- convolve(m,m)
cat(z,"\n")
dput(dimnames(z))

