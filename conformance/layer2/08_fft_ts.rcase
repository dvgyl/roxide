=== case: ts_correlation_missing_data_and_visibility ===
#@ tags: stats,ts
#@ compare: rel=1e-12,abs=1e-12
x <- ts(c(NA,2,3,4,NA),start=5,frequency=2)
y <- acf(x,1,plot=FALSE,na.action=na.omit)
cat(y$n.used,y$acf,y$lag,"\n")
seen <- withVisible(acf(c(1,NA,3,4),2,plot=FALSE,na.action=na.pass))
y <- seen$value
cat(seen$visible,y$n.used,y$acf,y$lag,"\n")
