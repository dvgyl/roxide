=== case: fft_named_and_inverse ===
#@ tags: stats,fft
#@ compare: rel=1e-13,abs=1e-13
x <- structure(c(a=1,b=2,c=3,d=4), note="data")
y <- fft(x)
dput(attributes(y))
cat(Re(y), Im(y), "\n")
cat(Re(fft(y, TRUE)), Im(fft(y, TRUE)), "\n")

=== case: fft_prime_and_mixed_radix ===
#@ tags: stats,fft
#@ compare: rel=1e-13,abs=1e-13
for (n in c(60L,97L,1009L)) {
    i <- seq_len(n)
    x <- sin(i/17) + 1i*cos(i/31)
    f <- fft(x)
    j <- c(1L,2L,3L,7L,n-1L,n)
    cat(sprintf("%.17g", Re(f[j])), sprintf("%.17g", Im(f[j])), "\n")
    cat(max(Mod(fft(f, TRUE)/n - x)), "\n")
}

