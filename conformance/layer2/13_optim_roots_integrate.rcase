=== case: optim_scaling_hessian_and_box ===
#@ tags: layer2,optim
#@ compare: rel=1e-6,abs=1e-7
f <- function(x) sum((x - c(1, -2))^2)
g <- function(x) 2 * (x - c(1, -2))
fit <- optim(c(x = 0, y = 0), f, g, method = "L-BFGS-B", lower = -.5, upper = .5)
cat(fit$par, fit$value, "\n")
fit <- optim(c(x = 0, y = 0), f, g, method = "BFGS", hessian = TRUE)
cat(fit$par, fit$value, fit$hessian, "\n")
fit <- optim(c(x = 0, y = 0), function(x) -f(x), function(x) -g(x),
             method = "BFGS", control = list(fnscale = -1, parscale = c(2, 3)))
cat(fit$par, fit$value, "\n")
cat(optimHess(c(1, 2), function(x) sum(x^4),
              control = list(parscale = c(2, 3), ndeps = c(.1, .2), fnscale = -3)), "\n")

