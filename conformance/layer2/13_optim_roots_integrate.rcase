=== case: integrate_divergent_extrapolation ===
#@ tags: layer2,optim
#@ compare: exact
x <- integrate(function(x) 1/x^2, 0, 1, stop.on.error = FALSE)
cat(x$message, "\n")
dput(x$subdivisions)
x <- integrate(function(x) x^2, 0, 1, rel.tol = 1e-20, abs.tol = 1e-20, stop.on.error = FALSE)
cat(x$message, "\n")
dput(x$subdivisions)
