=== case: optim_simplex ===
#@ tags: layer2,optim
#@ compare: rel=1e-6,abs=1e-7
f <- function(x) sum((x - c(1, -2))^2)
fit <- optim(c(x = 0, y = 0), f, method = "Nelder-Mead")
stopifnot(identical(unname(fit$counts), c(69L, NA_integer_)), identical(fit$convergence, 0L))
cat(fit$par, fit$value, "\n")

