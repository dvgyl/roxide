=== case: density_grid_and_metadata ===
#@ tags: layer2,smooth
#@ compare: rel=1e-8,abs=1e-10
x <- c(-2, 0, 1, 4)
d <- density(x, n = 4)
cat(names(d), class(d), d$n, d$data.name, d$has.na, d$old.coords, "\n")
cat(as.character(d$call[[1L]]), "\n")
cat(d$x, d$y, d$bw, "\n")
cat(density(x, n = 4, old.coords = TRUE)$y, "\n")

=== case: density_kernels_with_weights ===
#@ tags: layer2,smooth
#@ compare: rel=1e-8,abs=2e-10
for (kernel in c("gaussian", "epanechnikov", "rectangular", "triangular",
                 "biweight", "cosine", "optcosine")) {
    d <- density(c(-3, 0, 1.5), bw = .8, adjust = 1.2, weights = c(.1, .4, .5),
                 kernel = kernel, n = 24, from = -3, to = 4)
    cat(d$y, "\n")
}

