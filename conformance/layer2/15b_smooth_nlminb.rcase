=== case: loess_bivariate_interpolated_surface ===
#@ tags: layer2,smooth
#@ compare: rel=1e-6,abs=1e-8
d <- data.frame(x = c(1,2,2,3,3,4,5,5,6,6,7,7,8,9,9),
                z = c(3,5,2,6,1,4,8,7,2,4,5,9,6,2,8))
d$y <- sin(d$x) + d$x*d$z + log(d$z)
m <- loess(y ~ x + z, d, span = .85,
           control = loess.control(statistics = "exact"))
p <- predict(m, data.frame(x = c(1.5,3.5,4.8,5.5,6.2), z = c(3.8,4,5.4,4,6.1)),
             se = TRUE)
cat(m$kd$parameter, m$kd$a, m$kd$xi, "\n")
cat(p$fit, p$se.fit, p$residual.scale, p$df, "\n")

