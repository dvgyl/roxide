=== case: lm_anova_single ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),a=0:7,b=2*(0:7),f=factor(rep(c("lo","hi"),4)))
one <- function(x) {
    cat(class(x), names(x), rownames(x), "\n")
    for (v in x) cat(v, "\n")
}
one(anova(lm(y~a+b+f,d)))
one(anova(lm(y~1,d)))
one(anova(lm(y~0,d)))

=== case: lm_anova_model_comparisons ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),a=0:7,b=2*(0:7),f=factor(rep(c("lo","hi"),4)))
one <- function(x) {
    cat(class(x), names(x), rownames(x), "\n")
    for (v in x) cat(v, "\n")
}
small <- lm(y~a,d)
full <- lm(y~a+b+f,d)
for (type in list("F","Cp","Chisq","Rao","LRT",NULL)) one(anova(small,full,test=type))

=== case: lm_prediction_intervals_and_missing_rows ===
#@ tags: layer2,linmod
#@ compare: rel=1e-9,abs=1e-12
d <- data.frame(y=c(3,1,6,NA,8,4,9,5),a=0:7)
m <- lm(y~a,d,na.action=na.exclude)
cat(residuals(m), fitted(m), predict(m), "\n")
p <- predict(m,se.fit=TRUE,interval="confidence")
cat(names(p), colnames(p$fit), rownames(p$fit), p$fit,p$se.fit,p$df,p$residual.scale,"\n")
n <- data.frame(a=c(0,NA,5,8))
p <- predict(m,n,se.fit=TRUE,interval="prediction",level=.8)
cat(rownames(p$fit), p$fit,p$se.fit,p$df,p$residual.scale,"\n")

=== case: lm_prediction_poly_factors_and_terms ===
#@ tags: layer2,linmod
#@ compare: rel=1e-9,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),a=c(0,1,2,4,8,16,17,20),
                f=factor(rep(c("lo","hi"),4),levels=c("lo","hi")))
m <- lm(y~poly(a,2)+f,d)
n <- d[c(2,5,8),]
p <- predict(m,n,se.fit=TRUE)
cat(p$fit,p$se.fit,p$df,p$residual.scale,"\n")
q <- predict(m,n,type="terms",se.fit=TRUE,interval="confidence")
cat(colnames(q$fit), attr(q$fit,"constant"), q$fit,q$se.fit,q$lwr,q$upr,"\n")
tryCatch(predict(m,data.frame(a=2,f="new")),error=function(e)cat(conditionMessage(e),"\n"))

=== case: lm_prediction_rank_and_offset ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4),x=1:6,z=2*(1:6),o=c(0,1,2,0,1,2))
m <- lm(y~x+z+offset(o),d,offset=x/2)
n <- data.frame(x=2:4,z=c(4,7,8),o=c(0,1,0))
p <- predict(m,n,rankdeficient="non-estim")
cat(p, attr(p,"non-estim"), names(attr(p,"non-estim")), "\n")
p <- withCallingHandlers(predict(m,n),warning=function(w) {
    cat(conditionMessage(w),"\n")
    invokeRestart("muffleWarning")
})
cat(attr(p,"non-estim"), "\n")
cat(predict(m,n,rankdeficient="NA"), "\n")
cat(predict(m), fitted(m), "\n")

=== case: lm_dummy_aliased ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),a=0:7,b=2*(0:7),
                f=factor(rep(c("lo","hi"),4),levels=c("lo","hi")),
                g=factor(rep(c("A","B"),each=4)))
m <- lm(y~a+b+f,d)
for (use.na in c(FALSE,TRUE)) {
    z <- dummy.coef(m,use.na=use.na)
    cat(class(z), names(z), attr(z,"matrix"), "\n")
    for (v in z) cat(names(v), v, "\n")
}

