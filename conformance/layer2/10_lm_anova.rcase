=== case: lm_update_and_compare_information_criteria ===
#@ tags: layer2,linmod
#@ compare: rel=1e-9,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),x=0:7,z=c(0,2,1,3,6,7,4,5))
small <- lm(y~x,d)
big <- update(small,.~.+z, model=FALSE)
cat(coef(big), names(big), names(model.frame(big)), "\n")
scores <- AIC(small,big,k=3)
cat(names(scores), rownames(scores), scores$AIC, "\n")
cat(BIC(small,big)$BIC, "\n")
cat(class(lm(y~x,d,method="model.frame")), "\n")
