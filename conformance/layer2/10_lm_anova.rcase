=== case: lm_dummy_empty_and_intercept ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5))
for (f in list(y~1,y~0)) {
    m <- lm(f,d)
    for (use.na in c(FALSE,TRUE)) {
        z <- dummy.coef(m,use.na=use.na)
        cat(class(z), names(z), attr(z,"matrix"), "\n")
        for (v in z) cat(names(v), v, "\n")
    }
}

=== case: lm_extractors_and_influence ===
#@ tags: layer2,linmod
#@ compare: rel=1e-9,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),x=0:7,z=2*(0:7),w=c(1,0,2,3,1,4,2,1))
m <- lm(y~x+z,d,weights=w)
cat(coef(m), coef(m,complete=FALSE), deviance(m), df.residual(m), sigma(m), nobs(m), weights(m), "\n")
cat(vcov(m), confint(m), "\n")
cat(AIC(m), BIC(m), logLik(m), logLik(m,REML=TRUE), attr(logLik(m),"df"), "\n")
cat(names(hatvalues(m)), hatvalues(m), rstandard(m), rstudent(m), cooks.distance(m), "\n")

