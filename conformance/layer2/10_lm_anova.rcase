=== case: lm_fit_orders_and_pivot ===
#@ tags: layer2,linmod
#@ compare: rel=1e-11,abs=1e-13
x <- cbind(i=1,a=1:6,b=2*(1:6),g=c(1,0,1,0,1,0))
dimnames(x) <- list(c("a","b","c","d","e","f"), colnames(x))
y <- setNames(c(3,2,6,1,8,4), c("A","B","C","D","E","F"))
m <- lm.fit(x,y)
cat(names(m), names(m$qr), class(m$qr), "\n")
cat(m$rank, m$df.residual, names(m$coefficients), m$coefficients, "\n")
cat(m$qr$pivot, rownames(m$qr$qr), colnames(m$qr$qr), "\n")
cat(names(m$effects), m$effects, "\n")
cat(names(m$residuals), m$residuals, m$fitted.values, "\n")

=== case: lm_fit_errors_and_empty ===
#@ tags: layer2,linmod
#@ compare: exact
err <- function(e) cat(conditionMessage(e), "\n")
tryCatch(lm.fit(matrix(numeric(),0,1),numeric()), error=err)
tryCatch(lm.fit(cbind(1,1:2,1:2),1:2,singular.ok=FALSE), error=err)
tryCatch(lm.fit(cbind(1,0),1:2,tol=0), error=err)
tryCatch(lm.wfit(cbind(1,1:2),1:2,c(1,-1)), error=err)
m <- lm.fit(matrix(numeric(),2,0),setNames(c(3,4),c("a","b")),offset=1)
cat(names(m), typeof(m$rank), names(m$residuals), m$residuals, m$fitted.values, m$df.residual, "\n")

=== case: lm_weighted_zero_and_offset ===
#@ tags: layer2,linmod
#@ compare: rel=1e-11,abs=1e-13
x <- cbind(i=1,a=1:5,b=2*(1:5))
dimnames(x) <- list(c("a","b","c","d","e"), colnames(x))
y <- setNames(c(3,1,6,2,8), c("A","B","C","D","E"))
m <- lm.wfit(x,y,c(1,0,2,0,4),offset=1:5)
cat(names(m), m$rank, m$df.residual, m$coefficients, "\n")
cat(rownames(m$qr$qr), colnames(m$qr$qr), names(m$effects), m$effects, "\n")
cat(names(m$residuals), m$residuals, names(m$fitted.values), m$fitted.values, "\n")
z <- lm.wfit(x,y,rep(0,5),singular.ok=FALSE)
cat(names(z), length(z$residuals), z$coefficients, z$df.residual, "\n")

=== case: lm_multiple_responses ===
#@ tags: layer2,linmod
#@ compare: rel=1e-11,abs=1e-13
d <- data.frame(y=c(3,1,6,2,8),z=c(4,1,2,9,7),x=1:5,w=c(1,0,2,1,4))
m <- lm(cbind(y,z)~x,d,weights=w)
cat(class(m), dim(coef(m)), rownames(coef(m)), colnames(coef(m)), coef(m), "\n")
cat(dim(m$effects), dim(fitted(m)), dim(residuals(m)), "\n")
cat(sigma(m), deviance(m), predict(m,d[1:2,]), "\n")
one <- lm.fit(cbind(i=1,x=d$x), matrix(d$y,5,1))
cat(is.matrix(one$coefficients), one$coefficients, "\n")

=== case: lm_call_and_model_components ===
#@ tags: layer2,linmod
#@ compare: rel=1e-11,abs=1e-13
d <- data.frame(y=c(3,1,6,2,NA,4),x=1:6,z=2:7,f=factor(rep(c("a","b"),3)))
m <- lm(y~x+f,d,subset=x>1, offset=z, x=TRUE,y=TRUE,qr=FALSE,na.action=na.exclude)
cat(names(m), names(m$xlevels), m$xlevels$f, "\n")
cat(deparse1(m$call), names(m$model), colnames(model.matrix(m)), "\n")
cat(m$y, m$offset, coef(m), residuals(m), fitted(m), "\n")
n <- lm(y~x+f,d,model=FALSE)
cat(rownames(model.frame(n)), colnames(model.matrix(n)), "\n")

=== case: lm_summary_singular_columns ===
#@ tags: layer2,linmod
#@ compare: rel=1e-10,abs=1e-12
d <- data.frame(y=c(3,1,6,2,8,4,9,5),a=0:7,b=2*(0:7),
                f=factor(rep(c("lo","hi"),4),levels=c("lo","hi")),row.names=c("a","b","c","d","e","f","g","h"))
m <- lm(y~a+b+f,d)
s <- summary(m)
cat(names(s), s$df, s$aliased, "\n")
cat(rownames(s$coefficients), colnames(s$coefficients), s$coefficients, "\n")
cat(s$sigma,s$r.squared,s$adj.r.squared,s$fstatistic, s$cov.unscaled, "\n")

