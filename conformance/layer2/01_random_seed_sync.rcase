=== case: selected_kind_warnings ===
#@ tags: layer2,rng
withCallingHandlers({
    set.seed(42L, "Marsaglia", sample.kind = "Rounding")
    dput(RNGkind())
}, warning = function(w) {
    dput(conditionMessage(w))
    invokeRestart("muffleWarning")
})
