=== case: seed_query_and_remove ===
#@ tags: layer2,rng
dput(RNGkind())
dput(exists(".Random.seed", envir = .GlobalEnv, inherits = FALSE))
set.seed(42L, "Super-Duper", "Box-Muller")
rm(.Random.seed)
dput(exists(".Random.seed", envir = .GlobalEnv, inherits = FALSE))
dput(RNGkind())
dput(exists(".Random.seed", envir = .GlobalEnv, inherits = FALSE))
invisible(sample.int(1L))
dput(c(length(.Random.seed), .Random.seed[1]))
=== case: seed_copy_restore_and_local_shadow ===
#@ tags: layer2,rng
set.seed(42L)
old <- .Random.seed
first <- sample.int(100L, 5L)
dput(identical(old, .Random.seed))
.Random.seed <- old
dput(identical(first, sample.int(100L, 5L)))
.Random.seed <- old
draw <- function() {
    .Random.seed <- "ignored"
    sample.int(100L, 5L)
}
dput(identical(first, draw()))
dput(old[1:4])
=== case: seed_noninteger_warning ===
#@ tags: layer2,rng
.Random.seed <- 200
result <- withCallingHandlers(RNGkind(), warning = function(w) {
    dput(conditionMessage(w))
    invokeRestart("muffleWarning")
})
dput(result)
