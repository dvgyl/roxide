=== case: pi_trigonometry_exact_values ===
#@ tags: special,trigpi
#@ compare: exact
options(warn = -1)
x <- c(-Inf, -9007199254740992, -3, -2.5, -2, -1.5, -1, -0.5, -0, 0,
       0.5, 1, 1.5, 2, 2.5, 3, 2^52 - 0.5, 9007199254740992, Inf, NaN, NA_real_)
for (f in list(sinpi, cospi, tanpi)) {
    y <- f(x)
    cat(sprintf("%.17g", y), "\n")
    cat(sprintf("%.17g", 1 / y), "\n")
}
cat(sprintf("%.17g", tanpi(c(-1.25, -0.75, -0.25, 0.25, 0.75, 1.25))), "\n")

