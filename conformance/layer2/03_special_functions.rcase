=== case: bessel_endpoints_and_missing_values ===
#@ tags: special,bessel
#@ compare: exact
options(warn = -1)
x <- c(-1, 0, Inf, NaN, NA_real_)
for (n in c(-2.5, -1, 0, 0.5, 10, Inf, NA_real_, NaN)) {
    cat(sprintf("%.17g", besselI(x, n)), "\n")
    cat(sprintf("%.17g", besselJ(x, n)), "\n")
    cat(sprintf("%.17g", besselK(x, n)), "\n")
    cat(sprintf("%.17g", besselY(x, n)), "\n")
}
cat(sprintf("%.17g", besselI(c(1, 1, Inf, NaN), 0, c(NA, NaN, TRUE, TRUE))), "\n")
cat(sprintf("%.17g", besselK(c(1, 1, Inf, NaN), 0, c(NA, NaN, TRUE, TRUE))), "\n")

=== case: bessel_domain_and_precision_warnings ===
#@ tags: special,bessel
#@ compare: exact
for (f in list(besselI, besselJ, besselK, besselY))
    withCallingHandlers(cat(f(-1, 0), "\n"), warning = function(w) {
        cat(conditionMessage(w), "\n")
        invokeRestart("muffleWarning")
    })
for (f in list(besselI, besselJ, besselY))
    withCallingHandlers(cat(f(1e-6, 50), "\n"), warning = function(w) {
        cat(conditionMessage(w), "\n")
        invokeRestart("muffleWarning")
    })
