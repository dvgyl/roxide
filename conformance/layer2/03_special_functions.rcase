=== case: gamma_and_lgamma_finite ===
#@ tags: special,gamma
#@ compare: rel=1e-13
x <- c(-170.5, -50.5, -12.75, -3.625, -2.5, -1.25, -0.5, -0.01, 1e-150,
       0.01, 0.25, 0.5, 0.99, 1, 1.01, 1.5, 1.99, 2, 2.01, 3.75, 8, 24, 50, 100, 171.5)
cat(sprintf("%.17g", gamma(x)), "\n")
cat(sprintf("%.17g", lgamma(x)), "\n")

=== case: gamma_poles_and_nonfinite_values ===
#@ tags: special,gamma
#@ compare: exact
options(warn = -1)
x <- c(-Inf, -3, -2, -1, -0, 0, 1, 2, 3, 4, 172, Inf, NaN, NA_real_)
cat(sprintf("%.17g", gamma(x)), "\n")
cat(sprintf("%.17g", lgamma(x[c(1:8, 12:14)])), "\n")
withCallingHandlers(invisible(gamma(c(-2, -1, 0))), warning = function(w) {
    cat(conditionMessage(w), "\n")
    invokeRestart("muffleWarning")
})

=== case: gamma_near_negative_pole_warning ===
#@ tags: special,gamma
#@ compare: rel=1e-13
withCallingHandlers(cat(sprintf("%.17g", gamma(-20 + 1e-9)), "\n"), warning = function(w) {
    cat(conditionMessage(w), "\n")
    invokeRestart("muffleWarning")
})
withCallingHandlers(cat(sprintf("%.17g", lgamma(-20 + 1e-9)), "\n"), warning = function(w) {
    cat(conditionMessage(w), "\n")
    invokeRestart("muffleWarning")
})

