=== case: polygamma_finite_values ===
#@ tags: special,psi
#@ compare: rel=1e-13
x <- c(-50.75, -8.25, -3.875, -2.5, -1.25, -0.5, -0.125, 0.05, 0.5, 1, 1.5, 2, 4, 15, 50, 1000)
cat(sprintf("%.17g", digamma(x)), "\n")
cat(sprintf("%.17g", trigamma(x)), "\n")
for (d in 0:5)
    cat(sprintf("%.17g", psigamma(x, d)), "\n")
for (d in c(6, 17, 25, 50, 100))
    cat(sprintf("%.17g", psigamma(c(0.5, 1, 1.5, 2, 5, 20, 200), d)), "\n")

=== case: polygamma_poles_defaults_and_derivative_rounding ===
#@ tags: special,psi
#@ compare: exact
options(warn = -1)
x <- c(-Inf, -6, -1, -0, 0, Inf, NaN, NA_real_)
cat(sprintf("%.17g", digamma(x)), "\n")
cat(sprintf("%.17g", trigamma(x)), "\n")
cat(sprintf("%.17g", psigamma(x)), "\n")
cat(sprintf("%.17g", psigamma(x, c(0, 1, 2, 3, 4, 5, 6, 7))), "\n")
cat(sprintf("%.17g", psigamma(c(1, -0.5, Inf), c(-1, 6, -1))), "\n")
print(identical(psigamma(2, deriv = c(-0.5, 0.5, 1.5, 2.5)), psigamma(2, c(0, 0, 2, 2))))
withCallingHandlers(cat(psigamma(1, 101), "\n"), warning = function(w) {
    cat(conditionMessage(w), "\n")
    invokeRestart("muffleWarning")
})

=== case: beta_and_lbeta_finite_values ===
#@ tags: special,beta
#@ compare: rel=1e-13
a <- c(0.05, 0.5, 0.5, 1, 2, 2.5, 7, 8, 20, 100, 100, 500)
b <- c(0.125, 0.5, 0.75, 1e150, 2, 15, 5, 15, 250, 100, 1e30, 500)
cat(sprintf("%.17g", beta(a, b)), "\n")
cat(sprintf("%.17g", lbeta(b, a)), "\n")
cat(sprintf("%.17g", lbeta(c(1e200, 1e308), c(1e200, 1e308))), "\n")

