=== case: binomial_exact_values_and_rounding_warnings ===
#@ tags: special,choose
#@ compare: exact
options(warn = -1)
cat(sprintf("%.17g", choose(10, 0:11)), "\n")
cat(sprintf("%.17g", choose(-4, 0:6)), "\n")
cat(sprintf("%.17g", choose(c(-1.5, 1.25, 2.5, 4.5), c(2, 2, 3, 2))), "\n")
cat(sprintf("%.17g", choose(c(Inf, Inf, -Inf, 5, NaN, NA_real_), c(0, 3, 3, Inf, NA_real_, NaN))), "\n")
withCallingHandlers(cat(sprintf("%.17g", choose(7, c(-0.5, 0.5, 1.5, 2.5, 3 + 1e-8, 3 + 1e-10))), "\n"), warning = function(w) {
    cat(conditionMessage(w), "\n")
    invokeRestart("muffleWarning")
})

=== case: binomial_finite_values_and_symmetry ===
#@ tags: special,choose
#@ compare: rel=1e-13
n <- c(-250, -3.55, -0.35, 0.75, 18.5, 70, 100, 300, 300, 500, 1000)
k <- c(100, 85, 80, 90, 75, 30, 50, 65, 235, 250, 100)
cat(sprintf("%.17g", choose(n, k)), "\n")
cat(sprintf("%.17g", lchoose(n, k)), "\n")
print(identical(choose(300, 65), choose(300, 235)))

=== case: special_vector_attributes_and_named_arguments ===
#@ tags: special,attributes
#@ compare: exact
x <- structure(c(1, 2, 3, 4), dim = c(2L, 2L), dimnames = list(c("a", "b"), c("c", "d")))
dput(attributes(gamma(x)))
dput(attributes(beta(b = c(1, 2), a = x)))
dput(attributes(beta(1, x)))
dput(attributes(beta(c(2, 2, 2, 2), x)))
dput(attributes(choose(structure(numeric(), tag = "empty"), 1)))
dput(beta(1, structure(numeric(), tag = "empty")))
dput(attributes(besselI(nu = 0, x = x, expon.scaled = c(TRUE, FALSE))))
dput(attributes(besselK(nu = 0, x = x, expon.scaled = rep(TRUE, 8))))
dput(attributes(psigamma(1, deriv = structure(c(1, 2), names = c("a", "b")))))

