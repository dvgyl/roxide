=== case: multivar_print_clustering_and_components ===
#@ tags: layer2,multivar
#@ compare: exact
a <- rbind(a=c(0,0), b=c(0,2), c=c(10,0), d=c(10,2))
dimnames(a) <- list(c("a","b","c","d"),c("u","v"))
print(kmeans(a,a[c(1,3),]))
p <- prcomp(a)
p$rotation <- abs(p$rotation)
print(p)
print(summary(p))
q <- princomp(a)
print(q)
print(summary(q))
