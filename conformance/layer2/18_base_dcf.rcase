=== case: dcf_read_text_connections ===
#@ tags: base,dcf
#@ compare: exact
lines <- c("# top", "Name: café ", "Desc: x", "# comment", " . ", " y ", " .",
           " Empty: continuation", "Empty:", "Repeated: first", "Repeated: last", " ",
           "Name: second", "Only: y", "# last")
one <- function(...) {
    con <- textConnection(lines)
    on.exit(close(con))
    read.dcf(con,...)
}
m <- one(fields=c("Desc","Name","Repeated","Other","Empty"))
stopifnot(identical(dim(m),c(2L,5L)),
          identical(colnames(m),c("Desc","Name","Repeated","Other","Empty")),
          identical(unname(m[1,1]),"x\n\ny\n\nEmpty: continuation"),
          identical(unname(m[1,2]),"café"),
          identical(unname(m[1,3]),"last"),
          identical(unname(m[1,4]),NA_character_),
          identical(unname(m[1,5]),""),
          identical(unname(m[2,1]),NA_character_))
kept <- one(fields=c("Name","Desc"),keep.white=c("Name","Desc"))
stopifnot(identical(unname(kept[1,1]),"café "),
          identical(unname(kept[1,2]),"x\n\n y \n\n Empty: continuation"))
df <- one(fields=c("Repeated","Name","Only"),all=TRUE)
stopifnot(identical(class(df),"data.frame"),identical(names(df),c("Repeated","Name","Only")),
          identical(df$Repeated,list(c("first","last"),NA_character_)),
          identical(df$Name,c("café","second")), identical(df$Only,c(NA_character_,"y")))

=== case: dcf_read_invalid_and_empty ===
#@ tags: base,dcf
#@ compare: exact
read_text <- function(txt, ...) {
    con <- textConnection(txt)
    on.exit(close(con))
    read.dcf(con,...)
}
stopifnot(identical(dim(read_text(c("","# comment"))),c(0L,0L)),
          identical(unname(read_text(c("A : x", " # indented"))[1,1]),"x\n# indented"))
for (s in c("bad line"," y")) {
    tryCatch(read_text(s),error=function(e) cat(conditionMessage(e),"\n",sep=""))
    tryCatch(read_text(s,all=TRUE),error=function(e) cat(strsplit(conditionMessage(e),"\n",fixed=TRUE)[[1]][1:2],sep="\n"))
}
tryCatch(read_text("A: a",all=TRUE,fields="B"),error=function(e) cat(conditionMessage(e),"\n",sep=""))

=== case: dcf_write_wrapping_and_whitespace ===
#@ tags: base,dcf
#@ compare: exact
d <- data.frame(Name=" café ",Desc="alpha beta gamma delta epsilon\n\n  déjà  vu\n.\nend",Empty="")
write.dcf(d, width=25, indent=4)
write.dcf(d, width=25, indent=4, keep.white=c("Name","Desc"))
write.dcf(data.frame(A="ééé ééé ééé ééé"),width=14,indent=2)
write.dcf(data.frame(A=c(NA,"",NA," x "),B=NA))
write.dcf(matrix(c("x","y","z",NA),2,dimnames=list(NULL,c("A","B"))))
write.dcf(list(A="x",B=c("y","z")))

=== case: dcf_file_and_connection_roundtrips ===
#@ tags: base,dcf
#@ compare: exact
path <- tempfile()
d <- data.frame(A=c("café","x"),B=c(NA,"yes"))
write.dcf(d,path)
write.dcf(data.frame(A="extra",B="no"),path,append=TRUE)
m <- read.dcf(path)
stopifnot(identical(m[,1],c("café","extra")),
          identical(m[,2],c(NA,"no")))
src <- file(path)
stopifnot(!isOpen(src),identical(read.dcf(src),m),!isOpen(src))
close(src)
src <- file(path,"r")
stopifnot(identical(read.dcf(src),m),isOpen(src))
close(src)
dest <- textConnection("dcf_lines","w")
write.dcf(d,dest)
stopifnot(identical(textConnectionValue(dest),c("A: café","","A: x","B: yes")))
close(dest)
src <- textConnection(dcf_lines)
stopifnot(identical(read.dcf(src)[,1],d$A))
close(src)
unlink(path)

=== case: dcf_read_raw_encodings ===
#@ tags: base,dcf
#@ compare: exact
bytes <- c(as.raw(c(239,187,191)),charToRaw("A: café\n"))
src <- rawConnection(bytes)
m <- read.dcf(src)
stopifnot(identical(charToRaw(colnames(m)),as.raw(c(239,187,191,65))),
          identical(charToRaw(unname(m[1,1])),as.raw(c(99,97,102,195,169))),
          identical(Encoding(unname(m[1,1])),"unknown"))
close(src)
bytes <- c(as.raw(c(239,187,191)),charToRaw("A: caf"),as.raw(c(233,10)))
src <- rawConnection(bytes)
d <- read.dcf(src,all=TRUE)
stopifnot(identical(names(d),"A"),identical(charToRaw(d$A),as.raw(c(99,97,102,233))),
          identical(Encoding(d$A),"unknown"))
close(src)
