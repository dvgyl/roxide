#@ compare: rel=1e-7,abs=1e-12
for (f in list(gaussian(), binomial(), poisson(), Gamma(), inverse.gaussian(),
               quasi(), quasibinomial(), quasipoisson())) {
 cat(class(f), names(f), f$family, f$link, typeof(f$initialize), f$dispersion, "\n")
 cat(f$variance(c(.25,.8)), f$dev.resids(c(.3,.7),c(.25,.8),c(1,2)),
     f$validmu(NA_real_), f$validmu(Inf), "\n")
}
print(binomial(probit))
print(quasi(power(.5), "mu^2"))

=== case: glm_gaussian_fit_and_summary ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,y=c(1,0,2,3,2,5))
m <- glm(y~x,data=d)
s <- summary(m)
cat(class(m), names(m), names(s), names(m$qr), "\n")
cat(m$rank, m$df.residual, m$iter, m$converged, m$boundary, "\n")
cat(coef(m), m$deviance, m$null.deviance, m$aic, "\n")
cat(colnames(s$coefficients), s$coefficients, s$df, s$dispersion, "\n")
cat(vcov(m), as.double(logLik(m)), AIC(m), BIC(m), deviance(m), df.residual(m), "\n")
cat(colnames(summary(m,dispersion=2)$coefficients), summary(m,dispersion=2)$coefficients, "\n")

