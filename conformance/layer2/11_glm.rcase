#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=1:8,y=c(1,0,2,NA,2,5,7,3),f=factor(rep(c("a","b"),4)))
m <- glm(y~poly(x,2)+f,poisson,d,na.action=na.exclude,model=FALSE)
p <- predict(m,d[c(3,5,7),],type="response",se.fit=TRUE)
cat(p$fit,p$se.fit,p$residual.scale,"\n")
cat(predict(m),fitted(m),weights(m),"\n")

=== case: glm_residual_types_and_influence ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,n=c(1,0,2,3,2,5))
m <- glm(n~x,poisson,d,y=FALSE)
for (t in c("deviance","pearson","working","response","partial")) {
 r <- residuals(m,t)
 cat(t,r,dim(r),"\n")
}
i <- influence(m)
cat(names(i),hatvalues(m,infl=i),i$coefficients,i$sigma,"\n")
cat(rstandard(m,infl=i),rstandard(m,infl=i,type="deviance"),rstudent(m,infl=i),cooks.distance(m,infl=i),"\n")

=== case: glm_rank_deficiency_and_zero_columns ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,n=c(1,0,2,3,2,5),a=2*(-2:3))
m <- glm(n~x+a,poisson,d)
cat(coef(m),m$rank,m$qr$pivot,summary(m)$aliased,vcov(m),effects(m),"\n")
tryCatch(glm(n~x+a,poisson,d,singular.ok=FALSE),error=function(e)cat(conditionMessage(e),"\n"))
m <- glm(n~0,poisson,d)
cat(length(coef(m)),m$rank,m$iter,m$converged,m$boundary,m$deviance,m$null.deviance,"\n")
cat(predict(m),predict(m,se.fit=TRUE)$se.fit,"\n")

=== case: glm_binomial_control_and_nonconvergence ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
report <- function(fit) {
 g <- withCallingHandlers(fit,warning=function(w) {
  cat(conditionMessage(w),"\n")
  invokeRestart("muffleWarning")
 })
 cat(g$iter,g$converged,g$boundary,g$deviance,"\n")
}
d <- data.frame(x=-2:3,y=c(0,1,0,1,0,1))
report(glm(y~x,binomial,d,control=list(maxit=1)))
report(glm(y~x,binomial,d,start=c(0,0)))

