=== case: glm_count_family_simulation ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,y=c(0,1,0,1,0,1),n=c(1,0,2,3,2,5),w=c(1,2,3,4,5,6))
for (m in list(glm(y~x,binomial,d,weights=w),glm(n~x,poisson,d))) {
