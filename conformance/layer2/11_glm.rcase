=== case: glm_analysis_nested_gaussian_f_test ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,y=c(1,0,2,3,2,5),z=c(1,2,0,0,3,1))
f <- gaussian()
a <- glm(y~x,f,d)
b <- glm(y~x+z,f,d)
for (test in "F") {
 tab <- anova(a,b,test=test)
 cat(class(tab), names(tab), rownames(tab), "\n")
 cat(attr(tab,"heading"), "\n")
 cat(do.call(c,tab),"\n")
}

