=== case: glm_binomial_factor_and_matrix_simulation ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,y=c(0,1,0,1,0,1),n=c(1,0,2,3,2,5),w=c(1,2,3,4,5,6))
m <- glm(factor(y)~x,binomial,d)
set.seed(42)
out <- family(m)$simulate(m,2)
cat(names(out), as.integer(out[[1L]]), as.integer(out[[2L]]),"\n")
m <- glm(cbind(y,n)~x,binomial,d,weights=w)
set.seed(42)
out <- family(m)$simulate(m,2)
cat(colnames(out[[1L]]),out[[1L]],out[[2L]],"\n")
