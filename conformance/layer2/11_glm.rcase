=== case: glm_prediction_link_response_terms_and_errors ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
d <- data.frame(x=-2:3,y=c(1,0,2,3,2,5))
m <- glm(y~x,poisson,d,offset=x/10,x=TRUE)
for (t in c("link","response","terms")) {
 for (nd in list(NULL,data.frame(x=c(-1.5,.5,2.5)))) {
  p <- predict(m,nd,type=t,se.fit=TRUE)
  cat(names(p), names(p$fit), p$fit, p$se.fit, p$residual.scale, "\n")
 }
}
cat(predict(m,type="link"),predict(m,type="response"),"\n")
cat(predict(m,data.frame(x=c(-1.5,.5,2.5)),type="response"),"\n")

