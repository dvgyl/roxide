=== case: glm_response_validation_and_fractional_counts ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
warn <- function(w) {cat(conditionMessage(w),"\n"); invokeRestart("muffleWarning")}
err <- function(e) cat(conditionMessage(e),"\n")
x <- 1:5
for (f in list(binomial(), poisson(), Gamma(), inverse.gaussian(), quasipoisson())) {
 tryCatch(glm(c(-1,0,1,0,1)~x,f),error=err)
}
m <- withCallingHandlers(glm(c(0,.35,1,.4,.8)~x,binomial()),warning=warn)
cat(coef(m),"\n")
p <- withCallingHandlers(glm(c(1,2,3.2,1,2)~x,poisson()),warning=warn)
cat(p$aic,"\n")

