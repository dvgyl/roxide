=== case: glm_link_fields_and_functions ===
#@ tags: layer2,glm
#@ compare: rel=1e-7,abs=1e-12
for (name in c("logit","probit","cauchit","cloglog","identity","log","sqrt","1/mu^2","inverse")) {
 f <- make.link(name)
 eta <- c(.125,1,2)
 cat(class(f), names(f), f$name, f$linkinv(eta), f$mu.eta(eta),
     f$linkfun(f$linkinv(eta)), f$valideta(c(-1,0,1)), "\n")
}
for (lambda in c(-1,0,.5,1,2)) {
 f <- power(lambda)
 cat(f$name, f$linkinv(c(.2,1,2)), f$mu.eta(c(.2,1,2)), "\n")
}

