=== case: normal_uniform_exponential_lognormal_grids ===
#@ tags: layer2,distribution
#@ compare: rel=1e-12
show <- function(x) cat(sprintf("%.17g", x), "\n")
x <- c(-2, 0, 0.1, 1, 2)
p <- c(0.01, 0.25, 0.5, 0.9, 0.999)
show(dnorm(x, c(0, 1), 2, log = TRUE))
show(pnorm(x, lower.tail = FALSE, log.p = TRUE))
show(qnorm(log(p), lower.tail = FALSE, log.p = TRUE))
show(dunif(x, -1, 2))
show(punif(x, -1, 2, lower.tail = FALSE, log.p = TRUE))
show(qunif(log(p), -1, 2, lower.tail = FALSE, log.p = TRUE))
show(dexp(x, 2))
show(pexp(x, 2, lower.tail = FALSE, log.p = TRUE))
show(qexp(log(p), 2, lower.tail = FALSE, log.p = TRUE))
show(dlnorm(x, 1, 2))
show(plnorm(x, 1, 2, lower.tail = FALSE, log.p = TRUE))
show(qlnorm(log(p), 1, 2, lower.tail = FALSE, log.p = TRUE))

=== case: logistic_cauchy_and_weibull_grids ===
#@ tags: layer2,distribution
#@ compare: rel=1e-12
show <- function(x) cat(sprintf("%.17g", x), "\n")
x <- c(-2, 0.25, 1, 8)
p <- c(0.01, 0.25, 0.6, 0.999)
show(dlogis(x, 1, 2))
show(plogis(x, 1, 2, lower.tail = FALSE, log.p = TRUE))
show(qlogis(log(p), 1, 2, lower.tail = FALSE, log.p = TRUE))
show(dcauchy(x, 1, 2))
show(pcauchy(x, 1, 2, lower.tail = FALSE, log.p = TRUE))
show(qcauchy(log(p), 1, 2, lower.tail = FALSE, log.p = TRUE))
show(dweibull(x, 2, 3))
show(pweibull(x, 2, 3, lower.tail = FALSE, log.p = TRUE))
show(qweibull(log(p), 2, 3, lower.tail = FALSE, log.p = TRUE))

=== case: gamma_beta_and_chisq_grids ===
#@ tags: layer2,distribution
#@ compare: rel=1e-12
show <- function(x) cat(sprintf("%.17g", x), "\n")
x <- c(0.125, 0.5, 0.875)
p <- c(0.01, 0.25, 0.75, 0.99)
show(dgamma(x, c(0.5, 1.5, 3), rate = 2))
show(pgamma(x, 3, scale = 0.5, lower.tail = FALSE, log.p = TRUE))
show(qgamma(log(p), 3, 2, lower.tail = FALSE, log.p = TRUE))
show(dbeta(x, 2, 3))
show(pbeta(x, 2, 3, lower.tail = FALSE, log.p = TRUE))
show(qbeta(log(p), 2, 3, lower.tail = FALSE, log.p = TRUE))
show(dchisq(x, 3))
show(pchisq(x, 3, lower.tail = FALSE, log.p = TRUE))
show(qchisq(log(p), 3, lower.tail = FALSE, log.p = TRUE))

=== case: t_f_and_studentized_range ===
#@ tags: layer2,distribution
#@ compare: rel=1e-12
show <- function(x) cat(sprintf("%.17g", x), "\n")
x <- c(0.125, 1, 3)
p <- c(0.1, 0.3, 0.7, 0.9)
show(dt(x, 5))
show(pt(x, 5, lower.tail = FALSE, log.p = TRUE))
show(qt(log(p), 5, lower.tail = FALSE, log.p = TRUE))
show(df(x, 4, 9))
show(pf(x, 4, 9, lower.tail = FALSE, log.p = TRUE))
show(qf(log(p), 4, 9, lower.tail = FALSE, log.p = TRUE))
show(ptukey(c(0, 5, Inf), 4, 20))
show(qtukey(c(0, 1), 4, 10))

=== case: noncentral_densities_probabilities_and_quantiles ===
#@ tags: layer2,distribution
#@ compare: rel=1e-12
show <- function(x) cat(sprintf("%.17g", x), "\n")
x <- c(0.125, 0.5, 0.875)
p <- c(0.1, 0.5, 0.9)
show(dbeta(x, 2, 3, ncp = 2))
show(pbeta(x, 2, 3, ncp = 2))
show(qbeta(p, 2, 3, ncp = 2))
show(dchisq(x, 3, ncp = 2))
show(pchisq(x, 3, ncp = 2))
show(qchisq(p, 3, ncp = 2))
show(dt(x, 10, ncp = 1))
show(pt(x, 10, ncp = 1))
show(qt(p, 10, ncp = 1))
show(df(x, 4, 9, ncp = 2))
show(pf(x, 4, 9, ncp = 2))
show(qf(p, 4, 9, ncp = 2))
show(pbeta(1 - 1e-12, 2, 3, ncp = 2, lower.tail = FALSE, log.p = TRUE))
show(pf(1e10, 4, 9, ncp = 2, lower.tail = FALSE, log.p = TRUE))
show(pt(1e6, 5, ncp = 2, lower.tail = FALSE, log.p = TRUE))

=== case: distribution_attributes_and_namespace ===
#@ tags: layer2,distribution
#@ compare: exact
print(environment(runif))
x <- matrix(c(0, 1, 2, 3), 2L, dimnames = list(c("a", "b"), c("c", "d")))
dput(dim(dnorm(x, 0)))
dput(dimnames(pnorm(0, x)))
dput(names(dnorm(c(a = 0, b = 1), c(c = 1, d = 2))))
dput(names(dnorm(0:1, c(c = 1, d = 2))))
dput(qnorm(numeric(0), c(0, 1), 1))
dput(typeof(stats::dnorm(0)))

=== case: missing_and_invalid_distribution_arguments ===
#@ tags: layer2,distribution
#@ compare: exact
show <- function(x) withCallingHandlers(
    cat(x, "\n"),
    warning = function(w) {
        cat(conditionMessage(w), "\n")
        invokeRestart("muffleWarning")
    })
show(dnorm(c(NA, NaN, -Inf, Inf, 1, 2), c(NaN, NA, 0, 0, NaN, 0),
           c(-1, -1, 1, 1, NA, -1)))
show(punif(c(NA, NaN, -Inf, Inf), lower.tail = FALSE, log.p = TRUE))
show(qnorm(c(NA, NaN, -1, 0, 1, 2)))
show(dgamma(1, 1, rate = 1, scale = 1))
tryCatch(dgamma(1, 1, rate = 2, scale = 1), error = function(e) cat(conditionMessage(e), "\n"))

