=== case: grouped_and_recursive_callbacks ===
#@ tags: layer3,base,apply
#@ compare: exact
groups <- tapply(1:5, c("x", "y", "x", "y", NA), sum)
dput(as.vector(groups))
dput(dimnames(groups))
dput(rapply(list(1L, list(a = 2L, "skip")), function(x) x + 1L, classes = "integer"))
dput(pmax(c(NA, 2), c(5, NA), na.rm = TRUE))

=== case: string_replacements_and_encodings ===
#@ tags: layer3,base,strings
#@ compare: exact
dput(make.unique(c("a", "a", "a.1", "a")))
dput(utf8ToInt("Rö"))
dput(intToUtf8(c(65L, 0L, 233L), multiple = TRUE))
dput(iconv(c("résumé", "R"), to = "ASCII", sub = "?"))
dput(strtoi(c("0xff", "010", "-9", "8x")))
dput(encodeString(c("r", "test", NA), width = 5L, quote = "'", justify = "right"))
dput(strtrim(c("test", "éxo", NA), c(2L, 2L, 1L)))
dput(regexec("(a)?(b)", c("ab", "b", NA)))
x <- c("abcd", "ABCD")
substr(x, 2L, 4L) <- "q"
regmatches(x, regexpr("[a-z]+", x)) <- "R"
dput(x)

=== case: host_files_environment_and_source ===
#@ tags: layer3,base,io
#@ compare: exact
Sys.unsetenv("ROXIDE_W3_PROBE")
dput(Sys.getenv("ROXIDE_W3_PROBE", unset = NA))
dput(class(Sys.getenv()))
dput(class(Sys.getenv(names = FALSE)))
path <- tempfile()
dir.create(path)
from <- file.path(path, "input.R")
to <- file.path(path, "copy.R")
writeLines("value <- 42L", from)
dput(file.copy(from, to))
dput(file.size(to))
dput(file.append(to, from))
dput(readLines(to))
env <- new.env()
sys.source(to, envir = env)
dput(env$value)
dput(file.remove(from, to))
unlink(path, recursive = TRUE)
dput(interactive())
dput(readline())
dput(class(system.time(1 + 1)))
dput(names(proc.time()))

=== case: utils_package_metadata_and_combinations ===
#@ tags: layer3,utils,packages
#@ compare: exact
invisible(globalVariables(c("waveA", "waveB")))
dput(globalVariables("waveC"))
dput(as.character(packageVersion("utils")))
dput(packageDescription("utils", fields = "Version"))
dput(compareVersion("1.2", "1.10"))
dput(modifyList(list(x = list(a = 1L, b = 2L), y = 3L),
                list(x = list(a = NULL, c = 4L))))
dput(format(person("Ada", "Lovelace", email = "ada@example.org", role = "aut")))
dput(format(as.person("Ada Lovelace <ada@example.org> [aut]")))
dput(URLencode(c("a b/%20", "é"), reserved = TRUE))
dput(glob2rx(c("a*.R", "a?.R", "x[ab]")))
dput(combn(4L, 2L))

=== case: nested_print_dispatches_to_object_methods ===
#@ tags: layer3,base,print,s4
#@ compare: exact
print.WaveReport <- function(x, ...) {
    cat("S3 report\n")
    invisible(x)
}
invisible(setClass("WaveDisplay", slots = c(value = "numeric")))
invisible(setMethod("show", "WaveDisplay", function(object) {
    cat("S4 display", object@value, "\n", sep = " ")
}))
print.default(list(report = structure(7, class = "WaveReport"),
                   display = new("WaveDisplay", value = 2)))
