dput(anyDuplicated(c("a", "b", "a")))
dput(setdiff(c("b", "a", "b"), "a"))
dput(unlist(list(a = 1:2, b = list(c = 3, 4), 5)))
dput(unlist(list(a = list(b = list(1L, 2L), 3L, 4L))))
