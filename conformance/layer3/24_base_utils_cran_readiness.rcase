=== case: subset_and_replace_call_arguments ===
#@ tags: layer3,base,language
#@ compare: exact
x <- quote(f(x = 1L, y = 2L))
dput(typeof(x[-1L]))
dput(x[-1L])
dput(x[c("y", "missing")])
dput(x$y)
copy <- x
x[[1L]] <- as.name("g")
x["x"] <- list(4L)
x$z <- 7L
x[["y"]] <- NULL
dput(x)
dput(copy)

=== case: s4_flag_on_math_and_arithmetic ===
#@ tags: layer3,base,s4
#@ compare: exact
invisible(setClass("WaveNumeric", contains = "numeric"))
x <- new("WaveNumeric", c(1, 4, 9))
dput(vapply(list(x + 1, 1 + x, -x, sqrt(x), abs(x), round(x), log(x),
                 x == 1, !x, cumsum(x), sum(x), x[1L], rev(x)), isS4, FALSE))

