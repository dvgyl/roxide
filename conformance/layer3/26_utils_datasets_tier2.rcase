=== case: tier2_utils_archive_round_trip ===
#@ tags: layer3,utils,archive
#@ compare: exact
local({
    old <- setwd(tempdir())
    on.exit(setwd(old))
    dir.create("input")
    dir.create("input/empty")
    dir.create("input/nested")
    writeLines("three", "input/nested/c")
    writeLines("one", "input/a")
    writeLines("two", "input/b")
    for (mode in c("none", "gzip", "bzip2", "xz", "zstd")) {
        archive <- tempfile()
        out <- tempfile()
        stopifnot(utils::tar(archive, "input", compression = mode, tar = "internal") == 0L)
        stopifnot(identical(utils::untar(archive, list = TRUE, tar = "internal"),
                            c("input/a", "input/b", "input/empty/", "input/nested/", "input/nested/c")))
        stopifnot(utils::untar(archive, files = "input/b", exdir = out, tar = "internal") == 0L)
        stopifnot(identical(readLines(file.path(out, "input/b")), "two"),
                  !file.exists(file.path(out, "input/a")))
        stopifnot(utils::untar(archive, exdir = out, tar = "internal") == 0L)
        stopifnot(dir.exists(file.path(out, "input/empty")))
    }
})
cat("Archive checks passed\n")

=== case: tier2_utils_namespace_and_s3 ===
#@ tags: layer3,utils,namespace,s3
#@ compare: exact
waveGeneric <- function(x) UseMethod("waveGeneric")
waveGeneric.waveClass <- function(x) 42L
waveBinding <- 17L
stopifnot(identical(utils::packageName(asNamespace("utils")), "utils"),
          is.null(utils::packageName(globalenv())),
          isTRUE(utils::hasName(list(wave = 1L), "wave")),
          identical(utils::getFromNamespace("hasName", "utils"), utils::hasName),
          identical(utils::getFromNamespace("hasName", pos = "package:utils"), utils::hasName),
          identical(utils::getS3method("waveGeneric", "waveClass"), waveGeneric.waveClass),
          is.null(utils::getS3method("waveGeneric", "absent", optional = TRUE)),
          utils::isS3method("waveGeneric.waveClass"),
          !utils::isS3method("print.waveMissingClass"),
          identical(utils::isS3stdGeneric(waveGeneric), c(waveGeneric = TRUE)),
          identical(as.character(utils::methods(waveGeneric)), "waveGeneric.waveClass"),
          identical(as.character(utils::methods(class = "waveClass")), "waveGeneric.waveClass"),
          identical(utils::find("waveBinding"), ".GlobalEnv"),
          identical(utils::find("waveBinding", numeric = TRUE), c(.GlobalEnv = 1L)),
          identical(utils::apropos("^waveBinding$", where = TRUE), setNames("waveBinding", "1")))
where <- utils::getAnywhere("waveBinding")
stopifnot(identical(where$objs, list(.GlobalEnv = 17L)),
          identical(where$where, ".GlobalEnv"),
          identical(where$visible, TRUE),
          identical(where$dups, FALSE))
missing.binding <- utils::getAnywhere(waveMissingBinding)
stopifnot(identical(missing.binding$name, "waveMissingBinding"),
          identical(missing.binding$where, character()))
ns <- asNamespace("utils")
stopifnot(identical(names(formals(utils::assignInNamespace)), c("x", "value", "ns", "pos", "envir")))
stopifnot(identical(names(formals(utils::assignInMyNamespace)), c("x", "value")))
cat("Namespace checks passed\n")

=== case: tier2_utils_package_tools ===
#@ tags: layer3,utils,packages
#@ compare: exact
stopifnot(identical(names(formals(utils::install.packages)),
    c("pkgs", "lib", "repos", "contriburl", "method", "available", "destdir", "dependencies",
      "type", "configure.args", "configure.vars", "clean", "Ncpus", "verbose", "libs_only",
      "INSTALL_opts", "quiet", "keep_outputs", "...")))
env <- new.env()
env$waveExample <- function(x) x + 1L
root <- tempfile()
dir.create(root)
invisible(suppressMessages(utils::package.skeleton("waveTest", list = "waveExample",
                                                    environment = env, path = root)))
pkg <- file.path(root, "waveTest")
stopifnot(dir.exists(file.path(pkg, "R")), dir.exists(file.path(pkg, "man")),
          file.exists(file.path(pkg, "DESCRIPTION"), file.path(pkg, "NAMESPACE"),
                      file.path(pkg, "Read-and-delete-me")),
          identical(unname(read.dcf(file.path(pkg, "DESCRIPTION"))[1L, "Package"]), "waveTest"))
target <- new.env()
for (file in list.files(file.path(pkg, "R"), full.names = TRUE)) sys.source(file, target)
stopifnot(identical(target$waveExample(2L), 3L))
installed <- utils::installed.packages(lib.loc = root, fields = "WaveExample")
stopifnot(is.character(installed), is.matrix(installed),
          all(c("Package", "LibPath", "Version", "Priority", "Depends", "Imports", "LinkingTo",
                "Suggests", "Enhances", "License", "License_is_FOSS", "License_restricts_use",
                "OS_type", "MD5sum", "NeedsCompilation", "Built", "WaveExample") %in% colnames(installed)))
cat("Package tool checks passed\n")

