=== case: tier2_install_local_packages ===
#@ tags: layer3,utils,native,packages
#@ compare: exact
local({
    root <- tempfile("wave package ")
    dir.create(root)
    oracle <- Sys.getenv("ROXIDE_ORACLE_RSCRIPT")
    if (!is.null(R.version$nickname) && nzchar(oracle) &&
        grepl("/R.framework/", R.home(), fixed = TRUE) &&
        !startsWith(R.home(), "/Library/Frameworks/")) {
        # Run the relocated GNU R installer through its Rscript launcher.
        old.home <- R.home()
        on.exit(Sys.setenv(R_HOME = old.home))
        home <- file.path(tempdir(), "install-home")
        dir.create(file.path(home, "bin"), recursive = TRUE)
        paths <- list.files(old.home, full.names = TRUE)
        paths <- paths[basename(paths) != "bin"]
        stopifnot(all(file.symlink(paths, file.path(home, basename(paths)))))
        paths <- list.files(file.path(old.home, "bin"), full.names = TRUE)
        paths <- paths[basename(paths) != "R"]
        stopifnot(all(file.symlink(paths, file.path(home, "bin", basename(paths)))))
        wrapper <- file.path(home, "bin", "R")
        install <- shQuote(paste("Sys.setenv(R_HOME = Sys.getenv('ROXIDE_TEST_R_HOME'));",
                                 "tools:::.install_packages(commandArgs(TRUE)[-1L], no.q = TRUE)"))
        writeLines(c("#!/bin/sh", paste0("export ROXIDE_TEST_R_HOME=", shQuote(home)),
                     'export R_HOME="$ROXIDE_TEST_R_HOME"',
                     'export DYLD_FALLBACK_LIBRARY_PATH="$R_HOME/lib"',
                     'if [ "$1" = CMD ] && [ "$2" = INSTALL ]; then',
                     "  shift 2",
                     paste("  exec", shQuote(oracle), "--vanilla -e", install, 'install "$@"'),
                     "fi", paste("exec", shQuote(commandArgs()[[1L]]), '"$@"')),
                   wrapper)
        Sys.chmod(wrapper, "0755")
        Sys.setenv(R_HOME = home)
    }
    source <- file.path(root, "waveTest")
    dir.create(source)
    dir.create(file.path(source, "R"))
    writeLines(c("Package: waveTest", "Version: 1.0", "Title: Local Package",
                 "Description: Check local package installation.",
                 "Author: Test Author", "Maintainer: Test Author <test@example.org>",
                 "License: MIT"), file.path(source, "DESCRIPTION"))
    writeLines("export(waveExample)", file.path(source, "NAMESPACE"))
    writeLines(c("waveExample <- function() 42L",
                 'waveSet <- function() utils::assignInMyNamespace("waveExample", function() 44L)'),
               file.path(source, "R", "example.R"))
    first <- file.path(root, "first")
    second <- file.path(root, "second")
    dir.create(first)
    dir.create(second)
    utils::install.packages(source, lib = first, repos = NULL, type = "source", quiet = TRUE)
    stopifnot(file.exists(file.path(first, "waveTest", "DESCRIPTION")))
    archive <- file.path(root, "waveTest.tar.gz")
    old <- setwd(root)
    tryCatch(utils::tar(archive, "waveTest", compression = "gzip", tar = "internal"),
             finally = setwd(old))
    utils::install.packages(archive, lib = second, repos = NULL, type = "source", quiet = TRUE)
    packages <- utils::installed.packages(lib.loc = second)
    stopifnot(identical(unname(packages["waveTest", "Version"]), "1.0"))
    ns <- loadNamespace("waveTest", lib.loc = second)
    stopifnot(identical(utils::getFromNamespace("waveExample", ns)(), 42L))
    was.locked <- bindingIsLocked("waveExample", ns)
    utils::assignInNamespace("waveExample", function() 43L, ns)
    stopifnot(identical(utils::getFromNamespace("waveExample", ns)(), 43L))
    utils::getFromNamespace("waveSet", ns)()
    stopifnot(identical(utils::getFromNamespace("waveExample", ns)(), 44L),
              identical(bindingIsLocked("waveExample", ns), was.locked))
})
cat("Local installation checks passed\n")
