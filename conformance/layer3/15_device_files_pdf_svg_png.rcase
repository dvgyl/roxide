=== case: metrics_pdf_and_first_page_filename_format ===
#@ tags: layer3,devices
#@ compare: exact
pdf(NULL)
dput(dev.size())
dput(round(strwidth("AV", "inches"), 8))
invisible(dev.off())
for (one in c(TRUE,FALSE)) {
    p <- file.path(tempdir(), paste0("first-", one, "-%2d-%%.pdf"))
    pdf(p, onefile = one)
    plot.new()
    invisible(dev.off())
    dput(file.exists(file.path(tempdir(), paste0("first-", one, "- 1-%.pdf"))))
}

=== case: bmp_writes_numbered_pages ===
#@ tags: layer3,devices
#@ compare: exact
filename <- file.path(tempdir(), "bmp%03d.bmp")
result <- withVisible(grDevices::bmp(filename, width = 301, height = 243))
dput(is.null(result$value))
dput(result$visible)
dput(names(dev.list()))
dput(dev.size("px"))
plot.new()
plot.new()
invisible(dev.off())
for (i in 1:2) {
    path <- sprintf(filename, i)
    con <- file(path, "rb")
    b <- as.integer(readBin(con, "raw", 2L))
    close(con)
    dput(identical(b, c(66L, 77L)))
    dput(file.info(path)$size > 100)
}

