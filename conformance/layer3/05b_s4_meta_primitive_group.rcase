=== case: s4_group_dispatch_precedence ===
#@ tags: layer3,s4
invisible(setClass("RxA", slots = c(x = "numeric")))
invisible(setClass("RxB", contains = "RxA"))
setMethod("Ops", c("RxA", "RxA"), function(e1, e2) paste("Ops", .Generic))
setMethod("Arith", c("RxA", "RxA"), function(e1, e2) paste("Arith", .Generic))
setMethod("Compare", c("RxA", "RxA"), function(e1, e2) .Generic)
setMethod("+", c("RxA", "RxA"), function(e1, e2) "plus")
setMethod("Ops", c("RxB", "RxB"), function(e1, e2) "exact Ops")
a <- new("RxA", x = 3)
b <- new("RxB", x = 4)
dput(a + a)
dput(a * a)
dput(a < a)
dput(b + b)
dput(is.null(getMethod("*", c("RxA", "RxA"), optional = TRUE)))
dput(!is.null(selectMethod("*", c("RxA", "RxA"), optional = TRUE)))

=== case: s4_math_summary_and_complex ===
#@ tags: layer3,s4
invisible(setClass("RxA", slots = c(x = "numeric")))
a <- new("RxA", x = 4)
setMethod("Math", "RxA", function(x) .Generic)
setMethod("Math2", "RxA", function(x, digits) list(.Generic, missing(digits)))
setMethod("Summary", "RxA", function(x, ..., na.rm) list(.Generic, na.rm, length(list(...))))
setMethod("Complex", "RxA", function(z) list(.Generic, z@x))
dput(abs(a))
dput(log(a, 2))
dput(round(a))
dput(signif(a, digits = 2))
dput(sum(a))
dput(sum(a, 7, 8, na.rm = TRUE))
dput(Arg(a))

=== case: s4_subsetting_and_replacement ===
#@ tags: layer3,s4
invisible(setClass("RxA", slots = c(x = "numeric")))
a <- new("RxA", x = 4)
setMethod("[", "RxA", function(x, i, j, ..., drop) x@x + i)
setMethod("[[", "RxA", function(x, i, j, ...) x@x * i)
setMethod("$", "RxA", function(x, name) name)
setMethod("[<-", "RxA", function(x, i, j, ..., value) { x@x <- i + value; x })
setMethod("[[<-", "RxA", function(x, i, j, ..., value) { x@x <- i * value; x })
setMethod("$<-", "RxA", function(x, name, value) { x@x <- nchar(name) + value; x })
dput(list(a[2], a[[2]], a$field))
a[2] <- 7
dput(a@x)
a[[2]] <- 7
dput(a@x)
a$field <- 7
dput(a@x)

=== case: s4_attribute_methods ===
#@ tags: layer3,s4
invisible(setClass("RxA", slots = c(x = "numeric")))
a <- new("RxA", x = 4)
setMethod("names", "RxA", function(x) "names")
setMethod("dim", "RxA", function(x) c(2L, 3L))
setMethod("dimnames", "RxA", function(x) list("row", "column"))
setMethod("names<-", "RxA", function(x, value) { x@x <- nchar(value); x })
setMethod("dim<-", "RxA", function(x, value) { x@x <- sum(value); x })
setMethod("dimnames<-", "RxA", function(x, value) { x@x <- length(value); x })
setMethod("length", "RxA", function(x) 3L)
setMethod("length<-", "RxA", function(x, value) { x@x <- value; x })
dput(list(names(a), dim(a), dimnames(a), length(a)))
names(a) <- "set"
dput(a@x)
dim(a) <- c(2, 3)
dput(a@x)
dimnames(a) <- list("row", "column")
dput(a@x)
dput(getMethod("length", "RxA")(a))
dput(getMethod("length<-", "RxA")(a, 5)@x)

