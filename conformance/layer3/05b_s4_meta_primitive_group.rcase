          as.integer(a), as.logical(a), as.list(a)))
setMethod("as.double", "RxA", function(x, ...) .Generic)
dput(as.numeric(a))
dput(as.double(a))

=== case: s4_call_generic ===
#@ tags: layer3,s4
invisible(setClass("RxMeta", slots = c(x = "numeric")))
invisible(setGeneric("rxRestart", function(x, y = 3) standardGeneric("rxRestart")))
setMethod("rxRestart", "RxMeta", function(x, y) callGeneric(x@x))
setMethod("rxRestart", "numeric", function(x, y) x + y)
x <- new("RxMeta", x = 8)
dput(rxRestart(x, 7))
setMethod("rxRestart", "RxMeta", function(x, y) { x <- x@x; callGeneric() })
dput(rxRestart(x, 7))
setMethod("+", c("RxMeta", "numeric"), function(e1, e2) callGeneric(e1@x, e2))
dput(x + 9)

=== case: s4_metadata_queries ===
#@ tags: layer3,s4
invisible(setClass("RxMeta", slots = c(x = "numeric")))
invisible(setGeneric("rxRestart", function(x, y = 3) standardGeneric("rxRestart")))
setMethod("rxRestart", "RxMeta", function(x, y) x@x + y)
setMethod("rxRestart", "numeric", function(x, y) x + y)
setMethod("+", c("RxMeta", "numeric"), function(e1, e2) e1@x + e2)
x <- new("RxMeta", x = 8)
dput(getClasses(.GlobalEnv))
g <- getGenerics(.GlobalEnv, searchForm = TRUE)
dput(as.character(g))
dput(packageSlot(g))
dput(findMethodSignatures("rxRestart", where = .GlobalEnv))
dput(findMethodSignatures("rxRestart", where = .GlobalEnv, classes = "RxMeta", target = FALSE))
dput(names(findMethods("rxRestart", where = .GlobalEnv, package = ".GlobalEnv")))
dput(cacheGenericsMetaData("rxRestart", getGeneric("rxRestart")))
dput(packageSlot(getClass("RxMeta")))
dput(packageSlot(class(x)))
p <- "test"
packageSlot(p) <- "rxPackage"
dput(packageSlot(p))
e <- new.env(parent = .GlobalEnv)
invisible(setClass("RxLocal", slots = c(x = "numeric"), where = e))
invisible(cacheMetaData(e))
dput(getClasses(e))
classes <- getClasses(e, inherits = TRUE)
dput(any(classes == "RxMeta") && any(classes == "RxLocal"))
invisible(cacheMetaData(e, attach = FALSE))

