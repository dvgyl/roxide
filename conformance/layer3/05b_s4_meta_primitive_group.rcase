setOldClass("rxLegacy", prototype = structure(0, class = "rxLegacy"))
invisible(setClass("RxModern", contains = "rxLegacy", slots = c(tag = "character")))
invisible(setGeneric("rxOldDispatch", function(x) standardGeneric("rxOldDispatch")))
setMethod("rxOldDispatch", "rxLegacy", function(x) "old method")
format.rxLegacy <- function(x, ...) "S3 format"
x <- new("RxModern", tag = "modern")
dput(format(x))
dput(rxOldDispatch(x))
dput(class(S3Part(x, strictS3 = TRUE)))
dput(S3Part(structure(7L, class = "rxLegacy")))

=== case: s4_namespace_meta_lifecycle ===
#@ tags: layer3,s4,package-loader
fixture <- function(pkg, namespace, code) {
    d <- file.path(tempdir(), pkg)
    dir.create(file.path(d, "Meta"), recursive = TRUE)
    dir.create(file.path(d, "R"))
    writeLines(c(paste0("Package: ", pkg), "Version: 1.0"), file.path(d, "DESCRIPTION"))
    writeLines(namespace, file.path(d, "NAMESPACE"))
    writeLines(code, file.path(d, "R", pkg))
    saveRDS(list(Built = list(R = getRversion(), Platform = R.version$platform,
                              OStype = .Platform$OS.type),
                 DESCRIPTION = c(Package = pkg, Version = "1.0")), file.path(d, "Meta", "package.rds"))
}
fixture("rxmetaa",
        c("import(methods)", "exportClasses(RxExport)", "exportClassPattern('^RxPattern')",
          "exportMethods(rxMeta, names)"),
        c("setClass('RxExport', slots = c(value = 'numeric'))",
          "setClass('RxPattern', slots = c(value = 'numeric'))",
          "setClass('RxPrivate', slots = c(value = 'numeric'))",
          "setGeneric('rxMeta', function(x) standardGeneric('rxMeta'))",
          "setMethod('rxMeta', 'RxExport', function(x) x@value + 1)",
          "setMethod('names', 'RxExport', function(x) 'provided')"))
fixture("rxmetab",
        c("import(methods)", "importClassesFrom(rxmetaa, RxExport, RxPattern)",
          "importMethodsFrom(rxmetaa, rxMeta, names)", "export(probe)"),
        c("setClass('RxConsumer', slots = c(value = 'numeric'))",
          "setMethod('rxMeta', 'RxConsumer', function(x) x@value * 2)",
          "probe <- function() {",
          "    x <- new('RxExport', value = 5)",
          "    y <- new('RxConsumer', value = 7)",
          "    list(rxMeta(x), rxMeta(y), names(x), packageSlot(class(new('RxPattern'))))",
          "}"))
a <- loadNamespace("rxmetaa", lib.loc = tempdir())
s <- getNamespaceExports(a)
dput(c(any(s == ".__C__RxExport"), any(s == ".__C__RxPattern"),
       any(s == ".__C__RxPrivate"), any(s == ".__T__names:base")))
dput(sort(getClasses(a)))
b <- loadNamespace("rxmetab", lib.loc = tempdir())
dput(rxmetab::probe())
unloadNamespace(b)
library(rxmetaa, lib.loc = tempdir())
x <- new("RxExport")
dput(names(x))
detach("package:rxmetaa")
dput(names(x))
unloadNamespace(a)
dput(isNamespaceLoaded("rxmetaa"))
dput(is.null(getMethod("names", "RxExport", optional = TRUE)))
