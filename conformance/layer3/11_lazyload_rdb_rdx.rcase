=== case: lazy_load_raw_records_and_selection ===
#@ tags: layer3,lazy-load
#@ compare: exact
p <- file.path(tempdir(), "database")
a <- serialize(6L, NULL, version = 2)
b <- serialize(quote(x + 1L), NULL, version = 2)
writeBin(c(a, b), paste0(p, ".rdb"))
ka <- c(0L, length(a))
kb <- c(length(a), length(b))
saveRDS(list(variables = list(a = ka, b = kb),
             references = list(), compressed = 0.0), paste0(p, ".rdx"))
e <- new.env()
lazyLoad(p, e, function(names) names == "b")
dput(ls(e))
dput(is.primitive(lazyLoadDBfetch))
x <- 9L
dput(eval(e$b))
dput(lazyLoadDBfetch(ka, paste0(p, ".rdb"), FALSE, function(key) key))
dput(lazyLoadDBexec(p, function(frame) frame$vars, function(names) names != "b"))

=== case: persistent_environment_with_separate_lazy_binding ===
#@ tags: layer3,lazy-load
#@ compare: exact
p <- file.path(tempdir(), "persistent")
xdr <- function(x) serialize(x, NULL, version = 2)
header <- xdr(NULL)[1L:14L]
persist <- c(header, as.raw(c(0L, 0L, 0L, 247L, 0L, 0L, 0L, 0L,
                             0L, 0L, 0L, 1L, 0L, 4L, 0L, 9L,
                             0L, 0L, 0L, 6L)), charToRaw("env::1"))
desc <- xdr(list(bindings = list(value = 7L), enclos = baseenv(),
                 attributes = list(label = "env"), isS4 = FALSE, locked = TRUE))
binding <- xdr(11L)
writeBin(c(persist, desc, binding), paste0(p, ".rdb"))
variable <- c(0L, length(persist))
ref <- list(eagerKey = c(length(persist), length(desc)),
            lazyKeys = list(later = c(length(persist) + length(desc), length(binding))))
saveRDS(list(variables = list(a = variable, b = variable),
             references = list("env::1" = ref), compressed = FALSE), paste0(p, ".rdx"))
target <- new.env()
invisible(lazyLoad(p, target))
a <- target$a
dput(c(identical(a, target$b), environmentIsLocked(a), bindingIsLocked("value", a)))
dput(a$later)
dput(attr(a, "label"))
a$value <- 12L
dput(target$b$value)

=== case: serialization_reference_hooks ===
#@ tags: layer3,lazy-load,serialization
#@ compare: exact
e <- new.env()
replacement <- new.env()
write_key <- function(obj) if (identical(obj, e)) c("reference", "extra") else NULL
read_key <- function(key) {
    stopifnot(identical(key, c("reference", "extra")))
    replacement
}
labels <- paste0("item", 1:3)
obj <- list(labels, e, list(e, 3L))
raw <- serialize(obj, NULL, refhook = write_key)
check <- function(value) {
    dput(identical(value[[1L]], labels))
    dput(identical(value[[2L]], replacement))
    dput(identical(value[[3L]], list(replacement, 3L)))
}
check(unserialize(raw, refhook = read_key))
con <- rawConnection(raw, "rb")
check(unserialize(con, refhook = read_key))
close(con)
con <- rawConnection(raw(), "wb")
invisible(serialize(obj, con, refhook = write_key))
dput(identical(rawConnectionValue(con), raw))
close(con)
dput(tryCatch(serialize(e, NULL, refhook = function(x) character()), error = function(e) TRUE))
