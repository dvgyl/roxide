=== case: grid_hooks_and_frame ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
validDetails.probe <- function(x) { x$validated <- TRUE; x }
makeContext.probe <- function(x) { x$vp <- viewport(name = "hook"); x }
makeContent.probe <- function(x) {
    x$children <- gList(rectGrob(name = "generated"))
    x$childrenOrder <- "generated"
    x
}
obj <- gTree(name = "custom", cl = "probe")
grid.draw(obj)
dput(obj$validated)
dput(grid.ls(viewports = TRUE, print = FALSE)$name)
dput(childNames(grid.get("custom")))
invisible(dev.off())

=== case: grid_frame_layout ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
f <- frameGrob(grid.layout(2, 2), name = "frame")
f <- placeGrob(f, circleGrob(name = "placed"), row = 1, col = 2)
grid.draw(f)
dput(f$children[[1]]$row)
dput(f$children[[1]]$col)
dput(grid.get("placed")$name)
invisible(dev.off())

=== case: grid_axis_explicit_ticks_and_edits ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
axis <- yaxisGrob(at = c(.2, .8), label = c("A", "B"), name = "axis",
    edits = gEditList(gEdit("labels", gp = gpar(col = "red"))))
dput(childNames(axis))
dput(as.character(axis$children$ticks$y0))
dput(axis$children$labels$label)
dput(axis$children$labels$just)
dput(axis$children$labels$gp$col)
