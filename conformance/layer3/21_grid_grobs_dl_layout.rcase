#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
pushViewport(viewport(name = "area"))
grid.rect(name = "box")
popViewport()
cap <- grid.grab(name = "capture")
dput(childNames(cap))
dput(as.character(cap$children[[1]]$vp))
dput(class(cap$childrenvp))
invisible(dev.off())

