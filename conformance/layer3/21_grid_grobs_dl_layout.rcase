=== case: grid_display_list_and_capture ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
pushViewport(viewport(name = "area"))
grid.draw(gTree(name = "tree", children = gList(rectGrob(name = "box"))))
upViewport()
ax <- grid.xaxis(name = "axis")
dput(class(ax))
dput(names(ax))
dput(length(grid.get("axis")$children))
dput(grid.ls(viewports = TRUE, print = FALSE))
dput(getNames())
dput(grid.get(gPath("tree", "box"))$name)
invisible(dev.off())

=== case: grid_edit_and_remove ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
grid.draw(gTree(name = "tree", children = gList(rectGrob(name = "box"))))
grid.edit("tree::box", gp = gpar(fill = "red"), redraw = FALSE)
dput(grid.get("box")$gp$fill)
grid.remove("tree::box", redraw = FALSE)
dput(is.null(grid.get("box")))
invisible(dev.off())

=== case: grid_capture ===
