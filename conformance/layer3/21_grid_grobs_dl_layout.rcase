=== case: grid_glist_and_gpath ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
dput(names(nullGrob(name = "null")))
dput(names(rasterGrob(matrix("red"), name = "raster")))
children <- gList(rectGrob(name = "same"), NULL, circleGrob(name = "same"))
dput(childNames(gTree(name = "tree", children = children)))
dput(gPath("tree", "same"))
dput(tryCatch(gList(1), error = function(e) conditionMessage(e)))

=== case: grid_grob_geometry ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile(), width = 7, height = 7)
grid.newpage()
text <- textGrob("hello", name = "t")
dput(unitType(grobWidth(text)))
dput(round(convertWidth(grobWidth(text), "in", TRUE), 5))
dput(round(convertHeight(grobHeight(text), "in", TRUE), 5))
dput(round(convertWidth(grobWidth(textGrob("hello", rot = 90, name = "rot")), "in", TRUE), 5))
dput(round(convertWidth(grobWidth(textGrob("hello", gp = gpar(fontsize = 24), name = "big")), "in", TRUE), 5))
invisible(dev.off())

