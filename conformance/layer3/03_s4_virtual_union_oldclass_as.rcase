=== case: s4_virtual_and_multiple_inheritance ===
#@ tags: layer3,s4
#@ compare: exact
err <- function(expr) tryCatch(expr, error = function(e) conditionMessage(e))
setClass("A", slots = c(x = "numeric", y = "character", z = "ANY", n = "NULL"))
setClass("V", contains = "VIRTUAL", slots = c(t = "logical"))
setClass("E")
setClass("D", contains = c("A", "V"), slots = c(v = "integer"))
dput(isVirtualClass("V"))
dput(isVirtualClass("E"))
dput(isVirtualClass("D"))
dput(err(new("V")))
dput(err(new("E")))
d <- new("D", t = TRUE, x = 4)
dput(slotNames(d))
dput(d@t)
dput(extends("D"))
dput(extends("D", "A"))
dput(extends("D", "A", fullInfo = TRUE)@distance)
dput(names(extends("D", fullInfo = TRUE)))
dput(inherits(d, "A"))
dput(is(d))
a <- as(d, "A")
dput(attr(a, "class"))
dput(slotNames(a))
dput(a@x)
dput(identical(as(d, "A", strict = FALSE), d))
invisible(setAs("A", "character", function(from) as.character(from@x)))
dput(as(d, "character"))
as(d, "A") <- new("A", x = 10)
dput(d@x)
dput(d@t)

=== case: s4_union_and_old_class ===
#@ tags: layer3,s4
#@ compare: exact
err <- function(expr) tryCatch(expr, error = function(e) conditionMessage(e))
setClassUnion("NumberOrText", c("numeric", "character"))
setClass("U", slots = c(value = "NumberOrText"))
dput(isVirtualClass("NumberOrText"))
dput(err(new("NumberOrText")))
dput(is(1L, "NumberOrText"))
dput(is("s", "NumberOrText"))
dput(is(TRUE, "NumberOrText"))
dput(extends("integer", "NumberOrText"))
dput(as(1L, "NumberOrText"))
u <- new("U", value = 1L)
u@value <- "s"
dput(u@value)
setOldClass(c("oldSub", "oldBase"))
s <- structure(1, class = c("oldSub", "oldBase"))
dput(is(s, "oldBase"))
dput(isS4(s))
dput(extends("oldSub"))
dput(slotNames("oldSub"))
dput(err(new("oldSub")))

=== case: s4_conditional_inheritance_and_coercion ===
#@ tags: layer3,s4
#@ compare: exact
setClass("Source", slots = c(x = "numeric"), prototype = list(x = 1))
setClass("Target", slots = c(y = "numeric"))
invisible(setIs("Source", "Target",
                test = function(object) object@x > 0,
                coerce = function(from) new("Target", y = from@x),
                replace = function(from, value) {
                    from@x <- value@y
                    from
                }))
x <- new("Source")
dput(is(x, "Target"))
dput(is(new("Source", x = 0), "Target"))
dput(extends("Source", "Target", maybe = FALSE))
dput(extends("Source", "Target", maybe = NA))
dput(as(x, "Target")@y)
as(x, "Target") <- new("Target", y = 4)
dput(x@x)

=== case: s4_superclass_order_and_distances ===
#@ tags: layer3,s4
#@ compare: exact
setClass("Root", slots = c(x = "integer"))
setClass("Left", contains = "Root")
setClass("Right", contains = "Root")
setClass("Diamond", contains = c("Right", "Left"))
dput(extends("Diamond"))
dput(extends("Diamond", "Right", fullInfo = TRUE)@distance)
dput(extends("Diamond", "Left", fullInfo = TRUE)@distance)
dput(extends("Diamond", "Root", fullInfo = TRUE)@distance)
dput(extends("integer"))
dput(extends("matrix"))
dput(extends("array"))
dput(is(1L, "numeric"))
dput(is(matrix(1), "numeric"))

=== case: s4_setis_callback_can_remove_coercion ===
#@ tags: layer3,s4
setClass("RxFrom", slots = c(x = "numeric"))
setClass("RxTo", slots = c(x = "numeric"))
invisible(setIs("RxFrom", "RxTo",
    test = function(object) {
        removeClass("RxFrom")
        TRUE
    },
    coerce = function(from) new("RxTo", x = from@x + 1),
    replace = function(from, value) from))
obj <- new("RxFrom", x = 2)
dput(tryCatch(as(obj, "RxTo"), error = conditionMessage))

=== case: s4_inherited_coercion_and_redefined_extension ===
#@ tags: layer3,s4
setClass("RxRoot", slots = c(x = "numeric"))
setClass("RxParent", slots = c(x = "numeric"))
setClass("RxLeaf", contains = "RxParent")
invisible(setIs("RxParent", "RxRoot",
    coerce = function(from) new("RxRoot", x = from@x + 1),
    replace = function(from, value) from))
dput(as(new("RxLeaf", x = 2), "RxRoot")@x)
invisible(setIs("RxParent", "RxRoot",
    coerce = function(from) new("RxRoot", x = from@x + 3),
    replace = function(from, value) new("RxParent", x = value@x)))
edge <- getClass("RxParent")@contains$RxRoot
dput(edge@coerce(new("RxParent", x = 2))@x)
obj <- new("RxParent")
as(obj, "RxRoot") <- new("RxRoot", x = 5)
dput(obj@x)

=== case: s4_oldclass_uses_s4_layout_and_prototype ===
#@ tags: layer3,s4
setClass("RxOldLayout", contains = "numeric", slots = c(y = "integer"),
         prototype = prototype(2, y = 1L))
setOldClass("rxOldLayout", S4Class = "RxOldLayout")
def <- getClass("rxOldLayout")
dput(getSlots("rxOldLayout"))
dput(isVirtualClass("rxOldLayout"))
dput(as.numeric(def@prototype))
dput(attributes(def@prototype))
