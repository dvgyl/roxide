=== case: null_device_and_open_on_size_request ===
#@ tags: layer3,grdevices
#@ compare: exact
options(device = function(...) pdf(file = tempfile(tmpdir = tempdir())))
dput(dev.list())
dput(dev.cur())
dput(dev.next())
dput(dev.prev())
dput(dev.off(99))
dput(tryCatch(dev.off(1), error = function(e) conditionMessage(e)))
dput(dev.size())
dput(dev.cur())
dput(dev.size("cm"))
dput(dev.size("px"))
dput(withVisible(graphics.off()))
dput(dev.list())

=== case: device_selection_wraparound_and_reuse ===
#@ tags: layer3,grdevices
#@ compare: exact
options(device = function(...) pdf(file = tempfile(tmpdir = tempdir())))
dput(withVisible(dev.new()))
invisible(dev.new())
invisible(dev.new())
dput(dev.list())
dput(dev.cur())
dput(dev.next())
dput(dev.prev())
dput(dev.next(99))
dput(dev.prev(99))
dput(dev.set(99))
dput(dev.off(99))
dput(dev.off(3))
dput(dev.next(3))
dput(dev.prev(3))
dput(dev.set(3))
dput(dev.off())
dput(dev.cur())
dput(dev.set(1))
dput(dev.list())
dput(dev.cur())
graphics.off()
dput(dev.cur())
dput(dev.list())
