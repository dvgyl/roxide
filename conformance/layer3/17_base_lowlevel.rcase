=== case: low_level_results_and_coordinate_recycling ===
#@ tags: layer3,graphics
#@ compare: exact
pdf(file.path(tempdir(), "drawing.pdf"))
plot.new()
plot.window(c(0,5), c(0,5))
dput(withVisible(points(c(1,NA,3), 1:3, pch = c(19,21), bg = "red")))
dput(withVisible(lines(c(1,2,NA,3,4), c(1,2,NA,4,3))))
dput(withVisible(segments(1:3, 1, 4, 4:2, col = c("red","blue"))))
dput(withVisible(arrows(1,1,2,2, code = 3)))
dput(withVisible(rect(1:2, 1, 3:4, 2, border = FALSE, col = "grey")))
dput(withVisible(polygon(c(1,3,2,NA,2,3,4), c(1,1,3,NA,4,5,4))))
dput(withVisible(polypath(c(1,4,4,1,NA,2,3,3,2), c(1,1,4,4,NA,2,2,3,3),
                        rule = "evenodd", col = "red")))
dput(withVisible(abline(h = 2, v = 2)))
dput(withVisible(text(1:3, 2, "A", cex = .8)))
dput(withVisible(mtext("Top")))
dput(withVisible(title("Title", xlab = "X", ylab = "Y")))
dput(withVisible(box()))
dput(withVisible(clip(0,4,0,4)))
dput(withVisible(grid(nx = 2, ny = 2)))
dput(withVisible(rug(1:3)))
dput(withVisible(xspline(1:3, 3:1, shape = 0, draw = FALSE)))
dput(withVisible(rasterImage(matrix(c("red","blue","white","black"), 2), 1, 1, 2, 2)))
dput(withVisible(symbols(1:3, 3:1, circles = c(.5,1,.5), add = TRUE)))
dput(withVisible(curve(x^2, from = 1, to = 2, n = 3, add = TRUE)))
dput(withVisible(locator(1)))
invisible(dev.off())

=== case: base_drawing_builds_a_two_page_pdf ===
#@ tags: layer3,graphics
#@ compare: exact
path <- file.path(tempdir(), "pages.pdf")
pdf(path, 4, 3, compress = FALSE)
par(mfrow = c(1,2), mar = rep(0,4))
for (i in 1:3) {
    plot.new()
    plot.window(c(0,1), c(0,1), xaxs = "i", yaxs = "i")
    segments(.2,.2,.8,.8)
    rect(.4,.4,.6,.6, col = "red")
}
invisible(dev.off())
con <- file(path, "rb")
dput(rawToChar(readBin(con, "raw", 8L)))
close(con)
stream <- readLines(path, skipNul = TRUE, warn = FALSE)
dput(any(grepl("/Count 2", stream, fixed = TRUE, useBytes = TRUE)))
