=== case: s4_generic_signature_order ===
#@ tags: layer3,s4
invisible(setGeneric("rxChoose", function(x, y, lazy = stop("forced")) {
    standardGeneric("rxChoose")
}, signature = c("y", "x")))
setMethod("rxChoose", c(x = "integer", y = "numeric"), function(x, y, lazy) "x")
setMethod("rxChoose", c(x = "numeric", y = "integer"), function(x, y, lazy) "y")
dput(isGeneric("rxChoose"))
dput(getGeneric("rxChoose")@signature)
dput(rxChoose(1L, 2L))
dput(is.null(selectMethod("rxChoose", c("integer", "integer"), optional = TRUE, useInherited = FALSE)))
dput(existsMethod("rxChoose", c(x = "integer", y = "numeric")))
dput(hasMethod("rxChoose", c("integer", "integer")))
dput(names(findMethods("rxChoose")))
dput(removeGeneric("rxChoose"))
dput(isGeneric("rxChoose"))

=== case: s4_omitted_dispatch_argument_and_lazy_argument ===
#@ tags: layer3,s4
invisible(setGeneric("rxMissing", function(x, y = 3L, z) {
    standardGeneric("rxMissing")
}, signature = c("x", "y")))
setMethod("rxMissing", c("numeric", "missing"), function(x, y = 5L, z) {
    list(missing(y), y, .Generic[[1L]], as.character(.defined), as.character(.target))
})
dput(rxMissing(1L, z = stop("forced")))

=== case: s4_method_list_includes_cached_inheritance ===
#@ tags: layer3,s4
invisible(setGeneric("rxListMethods", function(x, y) standardGeneric("rxListMethods")))
setMethod("rxListMethods", "numeric", function(x, y) x)
setMethod("rxListMethods", c("ANY", "character"), function(x, y) y)
invisible(rxListMethods(1L, 2))
dput(names(findMethods("rxListMethods", inherited = TRUE)))
showMethods("rxListMethods", inherited = TRUE)
showMethods("rxListMethods", classes = "logical")

=== case: s4_signature_distances_and_ambiguity_notes ===
#@ tags: layer3,s4
setClass("X", slots = c(x = "numeric"))
setClass("Y", contains = "X")
setClass("Z", contains = "Y")
setClass("X2", slots = c(x = "numeric"))
setClass("Y2", contains = "X2")
setClass("Z2", contains = "Y2")
invisible(setGeneric("rxAnyDepth", function(a, b) standardGeneric("rxAnyDepth")))
setMethod("rxAnyDepth", c("ANY", "Z2"), function(a, b) "any-z2")
setMethod("rxAnyDepth", c("X", "X2"), function(a, b) "x-x2")
dput(rxAnyDepth(new("Z"), new("Z2")))
invisible(setGeneric("rxOrder", function(a, b) standardGeneric("rxOrder")))
setMethod("rxOrder", c("Z", "ANY"), function(a, b) "z-any")
setMethod("rxOrder", c("Y", "X2"), function(a, b) "y-x2")
dput(rxOrder(new("Z"), new("Z2")))
setClass("RxParents", contains = c("X2", "X"))
invisible(setGeneric("rxParentOrder", function(a) standardGeneric("rxParentOrder")))
setMethod("rxParentOrder", "X", function(a) "x")
setMethod("rxParentOrder", "X2", function(a) "x2")
dput(rxParentOrder(new("RxParents")))

=== case: s4_signature_constructor_and_implicit_classes ===
#@ tags: layer3,s4
dput(signature())
dput(signature(a = "numeric", "logical", z = NA_character_))
dput(tryCatch(signature(a = 1), error = conditionMessage))
invisible(setGeneric("rxClass", function(a, b) standardGeneric("rxClass")))
setMethod("rxClass", signature(a = "call", b = "missing"), function(a, b) "call")
setMethod("rxClass", signature(a = "language", b = "missing"), function(a, b) "language")
setMethod("rxClass", signature(a = "lm", b = "missing"), function(a, b) "lm")
dput(rxClass(quote(a + b)))
dput(rxClass(quote(a)))
dput(rxClass(structure(1, class = c("glm", "lm"))))
dput(tryCatch(rxClass("a"), error = conditionMessage))
