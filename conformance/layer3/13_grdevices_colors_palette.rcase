=== case: named_color_catalog ===
#@ tags: layer3,grdevices
#@ compare: exact
all_colors <- colors()
distinct_colors <- colors(TRUE)
dput(c(length(all_colors), length(distinct_colors)))
dput(head(distinct_colors))

=== case: color_matrix_channels ===
#@ tags: layer3,grdevices
#@ compare: exact
dput(col2rgb(c(a = "Light Blue", b = "GREY72", c = "#abc", d = "#12345678",
              e = NA_character_, f = "transparent"), alpha = TRUE))
dput(col2rgb(c(1L, 8L, 9L, 10L)))
dput(col2rgb(character(), alpha = TRUE))
dput(col2rgb(factor(c("red", "blue"))))

=== case: color_errors ===
#@ tags: layer3,grdevices
#@ compare: exact
for (col in list(0L, -2L, "not-a-color", "#12", "#FXX", "1x"))
    dput(tryCatch(col2rgb(col), error = function(e) conditionMessage(e)))

=== case: rgb_hsv_hcl_and_gray ===
#@ tags: layer3,grdevices
#@ compare: exact
dput(rgb(.5, 0, 0, alpha = .5))
dput(rgb(c(127.9, 255), 0, 0, names = c("a", "b"), maxColorValue = 255))
dput(rgb(matrix(c(.5, 1, 0, 0, 0, 1), ncol = 3)))
dput(hsv(c(0, 1, 1/3), 1, 1))
dput(hcl(c(0, 360), 50, 50))
dput(hcl(c(0, 120, 240, NA), 160, 50, fixup = FALSE))
dput(hcl(c(0, 90, 180, 270), 35, 85))
dput(gray(c(0, .5, 1), alpha = c(.5, 1)))
dput(gray.colors(3))
dput(gray.colors(2, alpha = c(.5, 1), rev = TRUE))

