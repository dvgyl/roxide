#@ compare: exact
dput(xy.coords(1:3 ~ 4:6))
dput(xy.coords(complex(real = 1:2, imaginary = 3:4)))
options(warn = -1)
dput(xy.coords(c(0, -1, 2), c(4, 0, 8), log = "xy"))

