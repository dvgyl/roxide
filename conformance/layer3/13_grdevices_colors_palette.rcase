=== case: boxplot_whiskers_and_notches ===
#@ tags: layer3,grdevices
#@ compare: exact
x <- c(1:8, 50)
dput(boxplot.stats(x))
dput(boxplot.stats(c(-Inf, 1:4, Inf, NA)))
dput(boxplot.stats(integer()))
dput(boxplot.stats(1:8, coef = 0))
dput(boxplot.stats(1:3, do.conf = FALSE, do.out = FALSE))

=== case: xy_coordinates ===
