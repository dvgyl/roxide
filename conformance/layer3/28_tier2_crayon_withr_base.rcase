=== case: obsolete_function_conditions ===
#@ tags: layer3,base,cran
#@ compare: exact
fields <- function(e) {
    cat(conditionMessage(e), "\n", sep = "")
    dput(class(e))
    dput(conditionCall(e))
    dput(list(e$old, e$new, e$package))
}
deprecated <- function() .Deprecated("replacement", package = "demo")
defunct <- function() .Defunct("replacement", package = "demo")
custom <- function() .Deprecated(msg = "Use another function.", old = "legacy")
withCallingHandlers(invisible(deprecated()), warning = function(w) {
    fields(w)
    invokeRestart("muffleWarning")
})
tryCatch(defunct(), defunctError = fields)
dput(withVisible(suppressWarnings(custom())))

=== case: unlink_paths_in_list ===
#@ tags: layer3,base,cran
#@ compare: exact
do_work <- function() {
    paths <- list(one = tempfile(), two = tempfile())
    on.exit(unlink(paths))
    writeLines("one", paths$one)
    writeLines("two", paths$two)
    dput(file.exists(paths$one, paths$two))
    paths
}
paths <- do_work()
dput(file.exists(paths$one, paths$two))
dput(withVisible(unlink(NULL)))

=== case: error_option_stores_handler_calls ===
#@ tags: layer3,base,cran
#@ compare: exact
run <- function() {
    old <- options(error = function(...) 1)
    on.exit(options(old))
    dput(typeof(getOption("error")))
    local({
        previous <- do.call(options, list(error = function(...) 2))
        on.exit(options(previous))
        dput(eval(getOption("error")))
    })
    dput(eval(getOption("error")))
    options(error = parse(text = "3L"))
    dput(eval(getOption("error")))
    dput(tryCatch(options(error = 4), error = conditionMessage))
}
run()

=== case: source_exposes_eval_context_and_runs_exit_handlers ===
#@ tags: layer3,base,cran
#@ compare: exact
f <- function() {
    path <- tempfile()
    on.exit(unlink(path))
    out <- character()
    register <- function() {
        calls <- as.list(sys.calls())
        frames <- as.list(sys.frames())
        index <- length(calls) - 4L
        dput(vapply(calls[index + 0:3], function(call) as.character(call[[1L]]), ""))
        frame <- frames[[index]]
        dput(identical(frame$envir, parent.frame()))
        dput(deparse1(frame$ei))
        cleanup <- function() out <<- c(out, "exit")
        do.call(on.exit, list(as.call(list(cleanup)), TRUE), envir = frame)
    }
    writeLines(c("out <- c(out, 'begin')", "register()", "out <- c(out, 'end')"), path)
    source(path, local = TRUE)
    dput(out)
}
f()
dput(source(exprs = list(quote(1L + 1L)))$value)
