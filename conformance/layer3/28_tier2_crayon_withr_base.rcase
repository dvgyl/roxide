=== case: rng_version_defaults ===
#@ tags: layer3,base,cran
#@ compare: exact
for (v in c("0.98.99", "1.6.0", "1.7.0", "3.5.0", "3.6.0", "4.6.2")) {
    set.seed(10, kind = "L'Ecuyer-CMRG", normal.kind = "Box-Muller",
             sample.kind = "Rejection")
    warnings <- character()
    previous <- withCallingHandlers(withVisible(RNGversion(v)), warning = function(w) {
        warnings <<- c(warnings, conditionMessage(w))
        dput(as.list(conditionCall(w))[-1L])
        invokeRestart("muffleWarning")
    })
    for (w in warnings) cat(w, "\n", sep = "")
    dput(previous$value)
    dput(previous$visible)
    dput(RNGkind())
}
dput(tryCatch(RNGversion("4"), error = conditionMessage))

=== case: timezone_cache_and_override ===
#@ tags: layer3,base,cran
#@ compare: exact
run <- function() {
    base <- baseenv()
    tz <- Sys.getenv("TZ", unset = NA_character_)
    on.exit(if (is.na(tz)) Sys.unsetenv("TZ") else Sys.setenv(TZ = tz))
    dput(bindingIsLocked(".sys.timezone", base))
    Sys.unsetenv("TZ")
    old <- Sys.timezone()
    dput(identical(old, get(".sys.timezone", base, inherits = FALSE)))
    unlockBinding(".sys.timezone", base)
    on.exit({
        if (bindingIsLocked(".sys.timezone", base)) unlockBinding(".sys.timezone", base)
        assign(".sys.timezone", old, base)
        lockBinding(".sys.timezone", base)
    }, add = TRUE)
    assign(".sys.timezone", NA_character_, base)
    Sys.setenv(TZ = "Europe/Paris")
    dput(Sys.timezone())
    dput(format(as.POSIXct("2020-01-01", tz = ""), "%Z"))
    Sys.unsetenv("TZ")
    dput(identical(Sys.timezone(), old))
}
run()
dput(bindingIsLocked(".sys.timezone", baseenv()))

