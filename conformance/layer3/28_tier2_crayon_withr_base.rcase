=== case: anyna_atomic_and_nested_lists ===
#@ tags: layer3,base,cran
#@ compare: exact
dput(c(anyNA(c(TRUE, NA)), anyNA(c(1L, NA_integer_)), anyNA(c(1, NaN)),
       anyNA(complex(real = 1, imaginary = NaN)), anyNA(c("x", NA)),
       anyNA(as.raw(0L)), anyNA(character()), anyNA(NULL)))
dput(c(anyNA(list(1, NA)), anyNA(list(1, c(1, NA)), recursive = FALSE),
       anyNA(list(1, c(1, NA)), recursive = TRUE),
       anyNA(list(list(NA))), anyNA(list(list(NA)), TRUE),
       anyNA(pairlist(x = c(1, NA)), TRUE)))
anyNA.marked <- function(x, recursive = FALSE) recursive
dput(anyNA(structure(1, class = "marked"), TRUE))
is.na.marked_only <- function(x) TRUE
dput(anyNA(structure(1, class = "marked_only")))
dput(anyNA(data.frame(x = c(1, NA))))
for (x in list(quote(x), parse(text = "NA"), list(1))) {
    dput(tryCatch(anyNA(x, NA), error = conditionMessage))
}

