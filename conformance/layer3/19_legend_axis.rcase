=== case: plot_limits_and_axis_ticks ===
#@ tags: layer3,graphics
#@ compare: exact
pdf(NULL)
plot(1:10, axes = FALSE, ann = FALSE)
dput(round(par("usr"), 8))
dput(round(axTicks(1), 8))
ticks <- withVisible(axis(1, c(NA,3,20), labels = c("","three","twenty")))
dput(ticks$value)
dput(ticks$visible)
dput(round(grconvertX(1, "chars", "inches"), 8))

=== case: legend_metrics_and_position ===
#@ tags: layer3,graphics
#@ compare: exact
pdf(NULL)
plot(1:10, axes = FALSE, ann = FALSE)
x <- withVisible(legend("topright", c("alpha","b"), lty = 1:2, plot = FALSE))
dput(x$visible)
dput(names(x$value))
r <- x$value$rect
dput(round(c(r$w, r$h, r$left, r$top), 7))
dput(round(x$value$text$x, 7))
dput(round(x$value$text$y, 7))
y <- legend("center", c("alpha","b"), fill = 1:2, horiz = TRUE, plot = FALSE)
dput(round(c(y$rect$w, y$rect$h, y$text$x, y$text$y), 6))

=== case: recordedplot_shape_and_replay_state ===
#@ tags: layer3,graphics
#@ compare: exact
pdf(NULL)
plot.new()
disabled <- recordPlot()
dput(is.null(disabled[[1L]]))
dev.control(displaylist = "enable")
plot(1:3, axes = FALSE, ann = FALSE)
p <- recordPlot()
dput(class(p))
dput(length(p))
dput(typeof(p[[1L]]))
dput(attr(p[[2L]], "pkgName"))
dput(attr(p, "engineVersion"))
dput(typeof(attr(p, "pid")))
dput(attr(p, "load"))
dput(attr(p, "attach"))
pdf(NULL)
replayPlot(p)
dput(round(par("usr"), 8))
dput(is.null(recordPlot()[[1L]]))

=== case: dev_copy_and_print_recorded_page ===
#@ tags: layer3,graphics,devices
#@ compare: exact
pdf(NULL)
dev.control("enable")
plot(1:3, axes = FALSE, ann = FALSE)
source <- dev.cur()
path <- file.path(tempdir(), "print.pdf")
out <- withVisible(dev.print(pdf, file = path))
dput(out$visible)
dput(identical(out$value, source))
dput(identical(dev.cur(), source))
dput(file.info(path)$size > 0)
copy <- withVisible(dev.copy(pdf, file = NULL))
dput(copy$visible)
dput(round(par("usr"), 8))
