=== case: grid_layout_matrix_respect ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile(), width = 8, height = 4)
grid.newpage()
box <- function(row, col) {
    pushViewport(viewport(name = "cell", layout.pos.row = row, layout.pos.col = col))
    on.exit(popViewport())
    round(c(current.transform()[3, 1:2],
        convertWidth(unit(1, "npc"), "in", TRUE),
        convertHeight(unit(1, "npc"), "in", TRUE)), 6)
}
w <- unit.c(unit(1, "in") + unit(1, "null"), unit(1:2, "null"))
h <- unit(1:2, "null")
marks <- matrix(c(0, 0, 1, 0, 0, 0), nrow = 2)
pushViewport(viewport(name = "matrix", layout = grid.layout(2, 3, w, h, respect = marks)))
dput(box(1, 2))
dput(box(2, 3))
popViewport()
invisible(dev.off())

