#@ compare: exact
library(grid)
pdf(tempfile(), width = 8, height = 4)
grid.newpage()
box <- function(row, col) {
    pushViewport(viewport(name = "cell", layout.pos.row = row, layout.pos.col = col))
    on.exit(popViewport())
    round(c(current.transform()[3, 1:2],
        convertWidth(unit(1, "npc"), "in", TRUE),
        convertHeight(unit(1, "npc"), "in", TRUE)), 6)
}
w <- unit.c(unit(1, "in") + unit(1, "null"), unit(1:2, "null"))
h <- unit(1:2, "null")
pushViewport(viewport(name = "overfull", layout = grid.layout(2, 2,
    unit(c(10, 1), c("in", "null")), unit(1:2, "null"), respect = TRUE)))
dput(box(1, 2))
invisible(dev.off())

=== case: grid_helvetica_string_metrics ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile(), width = 7, height = 7)
grid.newpage()
s <- c("A", "g", "AV", "a\nb", "")
dput(unitType(stringWidth(s)))
dput(round(convertWidth(stringWidth(s), "bigpts", TRUE), 6))
dput(round(convertHeight(stringHeight(s), "bigpts", TRUE), 6))
dput(round(convertHeight(stringAscent(s), "bigpts", TRUE), 6))
dput(round(convertHeight(stringDescent(s), "bigpts", TRUE), 6))
grid.clip(width = unit(2.54, "cm"), height = unit(5, "lines"))
invisible(dev.off())

=== case: grid_unit_and_viewport_conditions ===
#@ tags: layer3,grid
#@ compare: exact
library(grid)
pdf(tempfile())
grid.newpage()
u <- unit(1, "cm")
dput(tryCatch(u / u, error = function(e) conditionMessage(e)))
dput(tryCatch(2 / u, error = function(e) conditionMessage(e)))
dput(tryCatch(popViewport(), error = function(e) conditionMessage(e)))
invisible(dev.off())
