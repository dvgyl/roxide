=== case: promise_and_active_binding_visibility ===
#@ tags: layer3,eval
read <- function(x) withVisible(x)
forced <- function(x) { force(x); withVisible(x) }
dots <- function(...) withVisible(..1)
makeActiveBinding("binding", function() invisible(4L), globalenv())
dput(read(invisible(1L)))
dput(forced(invisible(2L)))
dput(dots(invisible(3L)))
dput(withVisible(binding))
dput(withVisible(if (FALSE) 1L))

